components.Page","fixerVersionsQuery":"t733v"},"data":{"document_data":{"dataItem-lvmip65e":{"type":"BackgroundMedia","id":"dataItem-lvmip65e","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"k4n-1035"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvmip65f":{"type":"BackgroundMedia","id":"dataItem-lvmip65f","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"k4n-1036"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvpqfsuw":{"type":"StyledText","id":"dataItem-lvpqfsuw","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"lso-212"},"text":"<h1 class=\"font_2\"><span class=\"color_36\">Serengeti National Park</span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvpqpmmr":{"type":"StyledText","id":"dataItem-lvpqpmmr","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-371"},"text":"<p class=\"font_8\" style=\"font-size:27px\"><span style=\"font-size:27px\"><span style=\"font-family:raleway,sans-serif\"><span style=\"letter-spacing:0em\">IMPORTANT FACTS </span></span></span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\"><span style=\"letter-spacing:0em\">Serengeti National Park stands as Africa&#39;s premier wildlife sanctuary, famed for its vast game populations and the spectacular annual migration of over a million wildebeest.&nbsp;</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"letter-spacing:0em\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></span></p>\n\n<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Most Prominent Wildlife :&nbsp;</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Lions: Known for their majesty and strength</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Cheetahs: These swift predators offer thrilling sightings.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Leopards: Elusive and powerful, .</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Wildebeest: With a population exceeding one million, they are the stars of the famed migration.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Zebras: Over 200,000 stripe landscapes&nbsp;</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Gazelles: More than 300,000 grace the plains.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Rhinos: &nbsp;A rare but treasured sighting.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Elephants: These gentle giants roam the expansive park.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Crocodiles: Often seen during river crossings.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Hippos: The Retina Hippo Pool alone is home to about 200 hippos.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Noteworthy Facts&nbsp;</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Endless Plains: The park features vast expanses of open grassland dotted with iconic acacia trees, often referred to as &quot;Lion King&quot; trees due to their cinematic fame.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Calving Season: Each February, the park becomes a nursery with around 8,000 wildebeest calves born daily, offering a unique spectacle.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Simba Kopjes: These granite outcroppings are favored resting spots for lions, providing them with a vantage point over the plains.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Seronera River: This vital water source draws a rich variety of wildlife, making it a hotspot for game viewing.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Grumeti and Mara Rivers: Known for heart-stopping wildebeest crossings, these rivers are key locations during the migration.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Lobo Valley: Offers stunning vistas and is an excellent place to view elephants and big cats in their natural environment.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\" style=\"font-size:10px\"><span style=\"font-size:10px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvpr0v7w":{"type":"Image","id":"dataItem-lvpr0v7w","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"620-0"},"title":"","uri":"1ac0ef_1d703aa0458843bcb4010e4ac6fab61e~mv2.png","description":"","width":756,"height":1507,"alt":"Note Pad","crop":{"x":181,"y":0,"width":573,"height":1507,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"name":"Brown Vintage Blank Paper Torn Your Story-2.png"},"dataItem-lvpr3xls":{"type":"StyledText","id":"dataItem-lvpr3xls","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-1412"},"text":"<p class=\"font_7\" style=\"font-size:25px\"><span style=\"font-size:25px\">Explore the iconic Serengeti National Park&nbsp;</span></p>\n\n<p class=\"font_7\" style=\"font-size: 9px;\"><span style=\"font-size:9px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_7\" style=\"font-size:16px\"><span style=\"font-size:16px\">Renowned as the epitome of wildlife viewing on the African continent. Home to the highest density of wildlife and the awe-inspiring Great Migration of countless wildebeest, the Serengeti stands as a premier destination for nature lovers and adventure seekers alike. Derived from the Maasai word for &#39;endless plains,&#39; the Serengeti truly stretches into the horizon, covering nearly 15,000 square kilometers (approximately 6,000 square miles) of vast landscapes. It ranks as Tanzania&#39;s second-largest national park, offering visitors spectacular scenes reminiscent of the world&rsquo;s most captivating nature documentaries. Discover our range of safari packages and experience the magic of the Serengeti firsthand.</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvpr6vkf":{"type":"StyledText","id":"dataItem-lvpr6vkf","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-929"},"text":"<h2 class=\"font_2\" style=\"font-size:21px\"><span class=\"color_15\"><span style=\"font-size:21px\">TRAVEL TIME TO SERENGETI NATIONAL PARK</span></span></h2>\n\n<h2 class=\"font_2\" style=\"font-size:21px\"><span class=\"color_15\"><span style=\"font-size:21px\"><span class=\"wixGuard\">​</span></span></span></h2>\n\n<ul class=\"font_8 color_15\">\n\t<li>\n\t<p class=\"font_8\"><span class=\"color_15\">Arusha to Serengeti: 5 hours&rsquo; drive.</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\"><span class=\"color_15\">Ngorongoro to Serengeti: 2 hours&rsquo; drive.</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\"><span class=\"color_15\">Lake Manyara to Serengeti: 3,5 hours&rsquo; drive.</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\"><span class=\"color_15\">Tarangire to Serengeti: 4 hours&rsquo; drive.</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\"><span class=\"color_15\">Flight Arusha to Serengeti: 1 hour (about &euro;238,- per person, one way).</span></p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvpr8h9r":{"type":"ImageList","id":"dataItem-lvpr8h9r","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-5007"},"items":["#dataItem-lvprefih1","#dataItem-lvprefig","#dataItem-lvprefih","#dataItem-lvprefih2","#dataItem-lvprefih3","#dataItem-lvprefih5","#dataItem-lvprefih6","#dataItem-lvprefih7"]},"dataItem-lvprefig":{"type":"Image","id":"dataItem-lvprefig","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"6wi-29"},"title":"The Great Migration","uri":"1ac0ef_7b131d1002ea4b23a3df825d61def4ad~mv2.png","width":590,"height":482,"alt":""},"dataItem-lvprefih":{"type":"Image","id":"dataItem-lvprefih","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"6wi-30"},"title":"Hippos Grazing","uri":"1ac0ef_6cd02712f9b74a5992de2b72994d51aa~mv2.jpg","width":1440,"height":1800,"alt":""},"dataItem-lvprefih1":{"type":"Image","id":"dataItem-lvprefih1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"6wi-31"},"title":"The Lion King","uri":"1ac0ef_09efe556ed1f4007879f2f72af93a3f4~mv2.jpg","width":1024,"height":768,"alt":""},"dataItem-lvprefih2":{"type":"Image","id":"dataItem-lvprefih2","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"6wi-32"},"title":"The mighty Buffalo","uri":"1ac0ef_aa4c3d5d3b7541e483dfa9abf5408092~mv2.jpg","width":4000,"height":3000,"alt":""},"dataItem-lvprefih3":{"type":"Image","id":"dataItem-lvprefih3","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"6wi-33"},"title":"Serengeti Gate","uri":"1ac0ef_f7359a205c5d42d6afbe3ed94a58de4a~mv2.png","width":4284,"height":5712,"alt":""},"dataItem-lvprefih5":{"type":"Image","id":"dataItem-lvprefih5","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"6wi-34"},"title":"Picnic In The Serengeti","uri":"1ac0ef_9eba42a53de44308b8a8fb0a6cd3bc16~mv2.jpg","width":3024,"height":4032,"alt":""},"dataItem-lvprefih6":{"type":"Image","id":"dataItem-lvprefih6","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"6wi-35"},"title":"Elephant Bathing In The River","uri":"1ac0ef_17a093c960474b6d8620d5f3d63b5054~mv2.jpg","width":4000,"height":3000,"alt":""},"dataItem-lvprefih7":{"type":"Image","id":"dataItem-lvprefih7","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"6wi-36"},"title":"Zebra Cuddles","uri":"1ac0ef_ea602e113cdc4996894faf2f806fc058~mv2.jpg","width":800,"height":533,"alt":""},"dataItem-lvprfcbb":{"type":"StyledText","id":"dataItem-lvprfcbb","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-1538"},"text":"<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Experience the Great Migration in Serengeti National Park</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">Witness the breathtaking Great Migration, the crown jewel of Serengeti National Park, featuring over a million wildebeest along with zebras and gazelles. This mesmerizing spectacle, where massive herds traverse 1,000 kilometers across the Serengeti plains, is a sight to behold. These herds, stretching up to 40 kilometers in length, brave the perilous journey through river crossings teeming with giant crocodiles and swift currents. Recognized as one of the Seven Natural Wonders of the World, the Great Migration offers an unparalleled wildlife experience, making it a top highlight for many travelers. The migration&#39;s timing varies annually, influenced by the rainfall patterns, but our skilled Mazingira Specialist guides can provide reliable forecasts to enhance your visit.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Discover More Wildlife in Serengeti National Park</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">Beyond the iconic wildebeest migration, Serengeti National Park is a sanctuary of unmatched biodiversity and natural beauty. The park is teeming with wildlife, hosting over 4,000 lions, 1,000 leopards, 225 cheetahs, and 3,500 hyenas, thriving amidst the abundant prey like wildebeest, zebras, gazelles, and buffaloes. As one of the premier locations to encounter the Big Five&mdash;rhinos, buffalos, elephants, lions, and leopards&mdash;the Serengeti offers sightings of nearly all celebrated African wildlife, including rare species such as the pangolin, East African oryx, rhino, and wild dog.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\">The park&#39;s diverse landscapes range from sweeping savannahs dotted with acacia trees to expansive grasslands, rugged mountains, serene lakes, and lush swamps. Each area presents its own unique environment and atmosphere, contributing to the park&#39;s designation as a UNESCO World Heritage Site.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvproncz":{"type":"StyledText","id":"dataItem-lvproncz","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-1899"},"text":"<p class=\"font_7\" style=\"font-size: 32px; text-align: center;\"><span style=\"font-size:32px\"><span class=\"color_36\">A visit to Serengeti National Park is not just a journey; it&#39;s an encounter that will resonate deep within your soul, touching every visitor with its profound natural beauty.</span></span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"t733v":{"type":"Page","id":"t733v","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"0qi-1"},"title":"The Serengeti","hideTitle":true,"icon":"","descriptionSEO":"Discover the Serengeti, Tanzania's iconic national park, renowned for its stunning landscapes and abundant wildlife. Explore the Great Migration, diverse ecosystems, and exceptional safari experiences. Ideal for wildlife enthusiasts and nature lover","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"the-serengeti","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tp