ight":1154,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvnopof5","mobileHintsQuery":"mobileHints-lw7o851m","connectionQuery":"connection-lvnopof8","anchorQuery":"anchors-lvnopof53","componentType":"wysiwyg.viewer.components.ClassicSection"}],"mobileMetaData":{"sig":"9nr-613"},"dataQuery":"#kjx0l","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1340,"height":1406,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvnopo71","mobileHintsQuery":"mobileHints-lvnopl99","connectionQuery":"connection-lvnopl9f","componentType":"mobile.core.components.Page","fixerVersionsQuery":"kjx0l"},"data":{"document_data":{"dataItem-lvnopl8q":{"type":"BackgroundMedia","id":"dataItem-lvnopl8q","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"oqg-3568"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvnopl8r":{"type":"BackgroundMedia","id":"dataItem-lvnopl8r","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"oqg-3569"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvnos5ac":{"type":"StyledText","id":"dataItem-lvnos5ac","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"oqg-3896"},"text":"<p class=\"font_8\">A classic tented safari offers a timeless escape into nature. Despite changes over the years, the sight of a simple canvas tent under a shady tree or beside a waterhole remains iconic in the safari experience.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\">Mazingira Camp partners ensure your comfort and a sense of home. Relax in your tent with the breeze through the canvas, or unwind in the communal area with a book and a refreshing drink. Sit back under the flysheet shade and watch the plains and wildlife.</p>\n\n<p class=\"font_8\">Evenings bring the cherished safari traditions of drinks and stories around the fire, evoking a sense of simpler times. Enjoy communal dining, celebrating the union of old and new friends. As night falls, the soft lamp light creates a serene ambiance, perfect for stargazing and observing the night&#39;s quiet activity.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span class=\"wixGuard\">​</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnotmbr":{"type":"StyledText","id":"dataItem-lvnotmbr","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"r8v-138"},"text":"<p class=\"font_4\" style=\"text-align: center;\">Our Tented Classic Safari&#39;s</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnozvv2":{"type":"Image","id":"dataItem-lvnozvv2","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"yhe-0"},"title":"","uri":"1ac0ef_2e8a6bcf719c4c39b997b15693a8359f~mv2.png","description":"","width":1859,"height":4032,"alt":"A tented accomodation for a tanzania safari, a beautiful located tented in the wilderness of Tanzania ","name":"Facetune_12-04-2024-17-59-46 2.HEIC"},"dataItem-lvnp12d1":{"type":"StyledText","id":"dataItem-lvnp12d1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"oqg-3910"},"text":"<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\"><span style=\"font-weight:bold\">Your home away from home</span></span></p>\n\n<p class=\"font_8\">Your tent is fully equipped for relaxation and reflection: a comfortable bed with soft linens ensures restful sleep after exciting safari days. The innovative bucket shower, heated over the fire, offers a refreshing end to your day. Mornings begin with the melodies of songbirds as you savor freshly brewed coffee or tea outside your tent. In the afternoon, reflect on your day&rsquo;s adventures at your writing desk, capturing the memories of your journey.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\"><span style=\"font-weight:bold\">Mobile camps</span></span></p>\n\n<p class=\"font_8\">Mazingira Camp partners&#39; mobile camps are ingeniously designed to move with the seasons, ensuring guests can experience unique and secluded locations&mdash;whether nestled in woodland greenery, under the shadow of a kopje, or along a riverbank. Always closely following the annual wildebeest migration, these camps are set up and taken down leaving only joyful memories behind.</p>\n\n<p class=\"font_8\">The camps&#39; discreet structures harmonize with the environment, often attracting wildlife right through the campsite. Elephants might choose a spot among the tents for a nap, while leopards could stealthily pass by as you enjoy dinner by the campfire. Staying at these camps offers a profound connection to nature and a deeper appreciation of the wild.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnpa5p9":{"type":"StyledText","id":"dataItem-lvnpa5p9","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"r8v-132"},"text":"<h1 class=\"font_4\" style=\"text-align: center;\"><span style=\"font-family:raleway,sans-serif;\"><span class=\"color_36\">Tanzania Classic camping safari</span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnpbiz8":{"type":"StylableButton","id":"dataItem-lvnpbiz8","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"oqg-4815"},"label":"SAMPLE ITINERARY","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-lvnpcqc2"},"dataItem-lvnpcqc2":{"type":"PageLink","id":"dataItem-lvnpcqc2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"oqg-4816"},"pageId":"#xdcvu","target":"_sel