ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2kvidf":{"type":"BackgroundMedia","id":"dataItem-lw2kvidf","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"b6y-3723"},"mediaRef":"#dataItem-lw2kvidf1","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2kvidf1":{"type":"Image","id":"dataItem-lw2kvidf1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"b6y-3722"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2kvidt":{"type":"StyledText","id":"dataItem-lw2kvidt","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-113"},"text":"<p class=\"font_8\">I am Johari, a proud Tanzanian born and raised on the slopes of Mount Kilimanjaro in the Kilimanjaro region. This region is famous for its remarkable attractions, particularly the majestic Mount Kilimanjaro, the tallest free-standing mountain in Africa. Growing up with breathtaking views of the peak every morning and evening, I knew from an early age that I wanted to work in tourism. My passion was further inspired by family members who worked as porters and mountain guides on the mountain.</p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">After finishing secondary school, I pursued a Bachelor&#39;s degree in Tourism and Cultural Heritage at the University of Dodoma. During my studies in 2013, I had the incredible opportunity to climb Mount Kilimanjaro via the Marangu route and reach the summit at Uhuru Peak, 5895 meters above sea level, earning a certificate. It was a significant milestone in achieving my dreams.</p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">Despite working outside the tourism industry for a while, gaining valuable customer service experience, my heart remained with my passion. I sought a path back into my dream field and found my way to Mazingira Eco Friendly Safari Adventures, where I now work as a travel and tour consultant. This role lets me connect with clients worldwide and refine my skills to craft remarkable trips to Tanzania and Africa.</p>\n\n<p class=\"font_8\">My dream is to become one of the most successful women in Tanzania&#39;s travel industry. I am excited to welcome you to Tanzania and Africa with professionalism and excellent customer service.</p>\n\n<p class=\"font_8\">Karibu!</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lw2pmyyn":{"type":"SvgShape","id":"dataItem-lw2pmyyn","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"f81-370"}},"x6mmt":{"type":"Page","id":"x6mmt","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"b6y-3782"},"title":"Johari Msangi ","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-jacob-kereiya","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2kvidd","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2kvidf","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2kvidn1":{"type":"MediaContainerDesignData","id":"dataItem-lw2kvidn1","metaData":{"isPreset":false,"schemaVersion":"1.0","is