schemaVersion":"2.0","isHidden":false,"sig":"8wu-3055"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2oy9y6":{"type":"BackgroundMedia","id":"dataItem-lw2oy9y6","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3058"},"mediaRef":"#dataItem-lw2oy9y61","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2oy9y61":{"type":"Image","id":"dataItem-lw2oy9y61","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-3057"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2oy9yh1":{"type":"SvgShape","id":"dataItem-lw2oy9yh1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3077"}},"dataItem-lw2oy9yj1":{"type":"StyledText","id":"dataItem-lw2oy9yj1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3126"},"text":"<p class=\"font_8\">I am Leonard, born and raised in the Arusha region, the heart of tourism in Tanzania. Seeing many safari vehicles filled with tourists sparked my passion for wildlife. After secondary school, I pursued my dream at the College of African Wildlife Management in Mweka, where I earned a diploma in wildlife management. To further refine my skills, I obtained a Level One certification from the Field Guide Association of Southern Africa (FGASA) while working as a resident guide in the Southern circuit.</p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">With the knowledge and experience I&#39;ve gained, I&#39;ve become one of the top safari guides for both the Northern and Southern circuit parks. I take great joy in meeting and interacting with people from around the world who visit Tanzania. Sharing my knowledge and experiences with guests ensures they enjoy the best safari possible and leave with unforgettable memories.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mn1":{"type":"Page","id":"x6mn1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-3114"},"title":"Leonard","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-adam-n","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2oy9y4","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2oy9y6","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2oy9ye1":{"type":"MediaContainerDesignData","id":"dataItem-lw2oy9ye1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3094"},"background":"#dataItem-lw2oy9ym","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lw2oy9ym":{"type":"BackgroundMedia","id":"dataItem-lw2oy9ym","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3095"},"color":"#FFFFFF","colorOpacity":1.0,"alignType":"center","fittingType":"fill","scrollType":"none","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo","colorLayers":["#dataItem-lw2oy9ym1"]},"dataItem-lw2oy9ym1":{"id":"dataItem-lw2oy9ym1","fill":{"type":"SolidColor","color":"{color_36}"},"opacity":0.88,"type":"SolidColorLayer","metaData":{"schemaVersion":"1.0","isPreset":false,"isHidden":false,"sig":"8wu-3096"}}},"beha