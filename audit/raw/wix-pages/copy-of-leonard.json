hemaVersion":"2.0","isHidden":false,"sig":"8wu-3156"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2ozlm6":{"type":"BackgroundMedia","id":"dataItem-lw2ozlm6","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3159"},"mediaRef":"#dataItem-lw2ozlm61","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2ozlm61":{"type":"Image","id":"dataItem-lw2ozlm61","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-3158"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2ozlmm":{"type":"SvgShape","id":"dataItem-lw2ozlmm","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3178"}},"dataItem-lw2ozlmo":{"type":"StyledText","id":"dataItem-lw2ozlmo","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3233"},"text":"<p class=\"font_8\">Also known as &lsquo;Daniel&rsquo;, I was born and raised in Ngarenanyuki at the base Mount Meru bordering Arusha National Park to the south. Following his grandfather footprints as a tour guide and his father as a forest reserve officer, he grew loving nature including feeding random birds flying to their home when he was a kid.</p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">Daniel studied full course of tour guiding aiming on mammals, trees and flowers and Marine parks. After several training on animal&rsquo;s behavior, Daniel understands animals extensively. Apart from his comprehensive knowledge in flora and fauna, he is great in leadership and customer service. His special interest is on birds as he found colorful birds very beautiful.</p>\n\n<p class=\"font_8\">Since 2010 he has lead multiple safaris in Tanzania and beyond borders. Daniel is very good in private game drives taking his clients away from crowds and common routes something that makes him quite unique.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mn2":{"type":"Page","id":"x6mn2","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-3215"},"title":"Solomon","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-leonard","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2ozlm4","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2ozlm6","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2ozlmh":{"type":"MediaContainerDesignData","id":"dataItem-lw2ozlmh","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3195"},"background":"#dataItem-lw2ozlmq2","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lw2ozlmq2":{"type":"BackgroundMedia","id":"dataItem-lw2ozlmq2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3196"},"color":"#FFFFFF","colorOpacity":1.0,"alignType":"center","fittingType":"fill","scrollType":"none","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo","colorLayers":["#dataItem-lw2ozlmq3"]},"dataItem-lw2ozlmq3":{"id":"dataItem-lw2ozlmq3","fill":{"type":"SolidColor","color":"{color_36}"},"opacity":0.88,"type":"SolidColorLayer","metaData":{"schemaVersion":"1.0","isP