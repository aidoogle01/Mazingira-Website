olor":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvp3wt8p":{"type":"StylableButton","id":"dataItem-lvp3wt8p","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-5106"},"label":"TERMS & CONDITIONS","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-lvp4mdgk"},"dataItem-lvp3zyt8":{"type":"StyledText","id":"dataItem-lvp3zyt8","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"cmo-198"},"text":"<h2 class=\"font_5\" style=\"font-size: 29px;\"><span style=\"font-size:29px;\"><span class=\"color_36\"><span style=\"font-family:raleway,sans-serif;\">Please read our Payment Terms and Conditions here :</span></span></span></h2>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp42m3x":{"type":"Image","id":"dataItem-lvp42m3x","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"gom-0"},"title":"","uri":"1ac0ef_c6b3aa48f5754806ae45459bf5cddecb~mv2.png","description":"","width":788,"height":788,"alt":"Booking process diagram for booking a safari through Mazingira Safaris","name":"White and Black Order Process Facebook Post (788 x 788 px).png"},"dataItem-lvp44ai1":{"type":"StyledText","id":"dataItem-lvp44ai1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"cmo-195"},"text":"<h1 class=\"font_2\" style=\"text-align: center;\"><span class=\"color_36\">Booking Process</span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp45xgm":{"type":"StyledText","id":"dataItem-lvp45xgm","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-4532"},"text":"<p class=\"font_8\"><span style=\"font-weight:bold\">Step 1 | Initial Contact</span></p>\n\n<p class=\"font_8\">Reach out to us by emailing info@mazingirasafari.com or by filling out our online enquiry form or even chatting to us on our web page chat service. Share your travel dates, desired destinations, budget, interests, and what type of experience you&rsquo;re looking for. Our safari specialist at Mazingira Safari will review your details to fully understand your needs.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">Step 2 | Review Your Options</span></p>\n\n<p class=\"font_8\">Your safari specialist will craft an initial itinerary that includes logistics, lodges, accommodations, and activities. This proposal will give you a clear picture of what to expect from your safari, along with an estimated cost per person.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\"><span style=\"font-family:roboto-thin,roboto,sans-serif\">Step 3 | Customize Your Journey</span></span></p>\n\n<p class=\"font_8\">Examine the proposed itinerary and discuss any changes or additional requests with your safari specialist. They will also offer alternative options if needed.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">Step 4 | Add the Finishing Touches</span></p>\n\n<p class=\"font_8\">Once you&#39;re happy with the itinerary, budget, lodges, and activities, we&#39;ll finalize the details and prepare a formal quote. We&#39;ll also begin securing accommodations and other essential components to ensure availability.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp49tzs":{"type":"StyledText","id":"dataItem-lvp49tzs","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"rtk-3005"},"text":"<p class=\"font_8\"><span style=\"font-weight:bold\">Step 5 | Confirm Your Safari</span></p>\n\n<p class=\"font_8\">Confirm your booking with a 30% deposit, which allows us to contractually secure your accommodations and logistics. We&#39;ll keep you informed throughout this process, providing all the necessary details and documentation.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">Step 6 | Pre-Safari Preparations</span></p>\n\n<p class=\"font_8\">About two months before your safari, we&#39;ll send you a comprehensive travel pack. This includes details about meet and greets, transfers, climate information, health tips, daily travel details, appropriate clothing, contact details while on safari, and emergency contacts.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">Step 7 | Experience Your Safari</span></p>\n\n<p class=\"font_8\">Arrive ready to embark on a life-changing safari experience with Mazingira Safari.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">Step 8 | Reflect on Your Journey</span></p>\n\n<p class=\"font_8\">After your adventure, you&rsquo;ll return with unforgettable memories and a piece of Africa in your heart. We cherish your feedback, which helps us maintain and improve our high standards of service. Look out for our follow-up email to share your thoughts.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp4exn4":{"type":"StyledText","id":"dataItem-lvp4exn4","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"rtk-3080"},"text":"<p class=\"font_8\" style=\"font-size:46px; text-align:center\"><span style=\"font-size:46px\"><span style=\"font-family:raleway,sans-serif\">Booking Process&nbsp;</span></span></p>\n\n<p class=\"font_8\" style=\"font-size: 6px; text-align: center;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\" style=\"text-align:center\">We are thrilled that you are considering booking a safari with us.</p>\n\n<p class=\"font_8\" style=\"text-align:center\">Designing memorable safaris is what we excel at, though we understand that the booking process may be new to some.</p>\n\n<p class=\"font_8\" style=\"text-align:center\">This page outlines the steps of the booking process, each one crucial to ensuring we create a truly exceptional safari tailored specifically for you.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp4hnse":{"type":"VectorImage","id":"dataItem-lvp4hnse","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"cmo-197"},"alt":"A drawn diagram to show the simplicity of the safari booking process with Mazingira Safaris","svgId":"06f469158f5346a3be7e4100e38370cd.svg"},"dataItem-lvp4mdgk":{"type":"PageLink","id":"dataItem-lvp4mdgk","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-5107"},"pageId":"#ktpyq","target":"_self"},"iiop0":{"type":"Page","id":"iiop0","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"36q-1"},"title":"Booking Process","hideTitle":true,"icon":"","descriptionSEO":"We're excited you're considering booking a safari with us! Our booking process is designed to be straightforward and informative. This page outlines each crucial step, ensuring we create an exceptional, personalized safari experience just for you. Let us guide you through the journey of planning your unforgettable adventure","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"terms-and-condition-payment-process","hidePage":false,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":false,"indexable":true,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lvgtvm2n","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lvgtvm2r","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"advancedSeoData":"{\"tags\":[{\"type\":\"meta\",\"props\":{\"name\":\"description\",\"content\":\"We're excited you're considering booking a safari with us! Our boo