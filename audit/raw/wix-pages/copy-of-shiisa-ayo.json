ersion":"2.0","isHidden":false,"sig":"8wu-545"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2lbumg":{"type":"BackgroundMedia","id":"dataItem-lw2lbumg","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-548"},"mediaRef":"#dataItem-lw2lbumg1","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2lbumg1":{"type":"Image","id":"dataItem-lw2lbumg1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-547"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2lbums":{"type":"SvgShape","id":"dataItem-lw2lbums","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-567"}},"dataItem-lw2lbumu":{"type":"StyledText","id":"dataItem-lw2lbumu","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-607"},"text":"<p class=\"font_8\">I am Daniel Fredrick, born and raised in a community that practiced agriculture and animal husbandry on the border of Arusha National Park. My brother, who worked as a guide, often took me on nature walks through conservation areas, teaching me about the rich flora and fauna before I began college in 2007. Over the past 14 years, I&#39;ve dedicated my life to nature and tourism, working as a professional safari guide in Tanzania.</p>\n\n<p class=\"font_8\">Working with the Mazingira team brings me immense joy, as our shared pursuit of service excellence unites us. Our mutual values of delivering professional service in both nature and hospitality fuel my success.</p>\n\n<p class=\"font_8\">There have been many memorable moments in my career, but witnessing the beauty of the Great Migration stands out. Observing millions of wildebeest and zebras crossing the Mara River into Kenya was a truly fascinating spectacle and an unforgettable highlight.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mmv":{"type":"Page","id":"x6mmv","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-606"},"title":"Daniel Fredrick","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-shiisa-ayo","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2lbume","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2lbumg","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2lbump1":{"type":"MediaContainerDesignData","id":"dataItem-lw2lbump1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-584"},"background":"#dataItem-lw2lbumx","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lw2lbumx":{"type":"BackgroundMedia","id":"dataItem-lw2lbumx","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-585"},"color":"#FFFFFF","colorOpacity":1.0,"alignType":"center","fittingType":"fill","scrollType":"none","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo","colorLayers":["#dataItem-lw2lbumx1"]},"dataItem-lw2lbumx1":{"id":"dataItem-lw2lbumx1","fill":{"type":"SolidColor","color":"{color_36}"},"opacity":0.88,"type":"SolidColorLayer","metaData":{"schemaVersion":"1.0","isPreset":false,"isHidden":false,"sig":"8wu-586"}}},"behaviors_data":{"behavior-lw2lbumq":{"type":"ObsoleteBehaviorsList","id":"behavior