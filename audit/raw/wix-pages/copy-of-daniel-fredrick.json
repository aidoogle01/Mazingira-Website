aVersion":"2.0","isHidden":false,"sig":"8wu-641"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2lev2n":{"type":"BackgroundMedia","id":"dataItem-lw2lev2n","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-644"},"mediaRef":"#dataItem-lw2lev2n1","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2lev2n1":{"type":"Image","id":"dataItem-lw2lev2n1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-643"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2lev2x1":{"type":"SvgShape","id":"dataItem-lw2lev2x1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-663"}},"dataItem-lw2lev2z1":{"type":"StyledText","id":"dataItem-lw2lev2z1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-713"},"text":"<p class=\"font_8\">I am David Raston, born in Arusha and grew up working on family projects focused on agriculture and biology, which sparked my passion for nature. Later, I pursued my interest in wildlife studies at university, graduating with a BSc in Wildlife Management. From that point on, I dedicated my life to nature conservation.</p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">I joined the Mazingira team in 2016 and have been sharing my wildlife and cultural knowledge with our valued clients and friends about various destinations ever since. Working with the Mazingira team brings me joy because it allows me to practice my service at its best. We all share a commitment to professional service delivery, whether it&#39;s in nature or hospitality.</p>\n\n<p class=\"font_8\">One of the most striking experiences in my career was witnessing how nature can be both beautiful and harsh. During the wildebeest calving season, I watched a baby wildebeest being born, only to be hunted by a cheetah an hour later. Moments like these capture the raw reality of the natural world.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mmw":{"type":"Page","id":"x6mmw","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-701"},"title":"David Raston","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-daniel-fredrick","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2lev2m","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2lev2n","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2lev2v1":{"type":"MediaContainerDesignData","id":"dataItem-lw2lev2v1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-680"},"background":"#dataItem-lw2lev312","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lw2lev312":{"type":"BackgroundMedia","id":"dataItem-lw2lev312","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-681"},"color":"#FFFFFF","colorOpacity":1.0,"alignType":"center","fittingType":"fill","scrollType":"none","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo","colorLayers":["#dataItem-lw2lev32"]},"dataItem-lw2lev32":{"id":"dataItem-lw2lev32","fill":{"type":"SolidColor","color":"{co