":"2.0","isHidden":false,"sig":"b6y-3022"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2kezvk":{"type":"BackgroundMedia","id":"dataItem-lw2kezvk","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"b6y-3049"},"mediaRef":"#dataItem-lw2kezvk1","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2kezvk1":{"type":"Image","id":"dataItem-lw2kezvk1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"b6y-3019"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2kezw9":{"type":"SvgShape","id":"dataItem-lw2kezw9","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"b6y-2087"}},"dataItem-lw2kezwg":{"type":"StyledText","id":"dataItem-lw2kezwg","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"b6y-2460"},"text":"<p class=\"font_8\">Hello from Mazingira Safaris! I&#39;m Jacob, the Director here, and I&rsquo;m delighted to share my story with you. My journey in the world of safari began over 15 years ago, guiding guests through the breathtaking landscapes of Tanzania. Having worked with top-tier safari companies including Kibo Guide Safari, Sokwe Asilia, Nomad Tanzania, and Wayo Africa, I&#39;ve gathered a wealth of experience and a deep love for this land and its wildlife.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Through my years as a guide, I&#39;ve had the privilege of introducing adventurers from around the world to the wonders of the Serengeti, the mysteries of Ngorongoro, and beyond. This experience has not only honed my skills but deepened my commitment to conservation and responsible tourism.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Here at Mazingira Safaris, my team and I are dedicated to crafting unforgettable safari experiences. We&#39;re passionate about sharing the beauty of Tanzania with you, helping to plan your dream safari with all the insights and personal touches that only a local expert can provide. Join us to discover the magic of Tanzania, and let us turn your safari dreams into reality.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mms":{"type":"Page","id":"x6mms","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"b6y-3054"},"title":"Jacob Kereiya","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"popup-x6mms","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"ref":"#dataItem-lw2kezvg"},"mobile":{"custom":true,"ref":"#dataItem-lw2kezvk","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2kezw41":{"type":"MediaContainerDesignData","id":"dataItem-lw2kezw41","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"b6y-3447"},"background":"#dataItem-lw2kezx6","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lw2kezx6":{"type":"BackgroundMedia","id":"dataItem-lw2kezx6","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"b6y-3448"},"color":"#FFFFFF","colorOpacity":1.0,"alignType":"center","fittingType":"fill","scrollType":"none","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo","colorLayers":["#dataItem-lw2kny391"]},"dataItem-lw2kny391":{"id":"dataItem-lw2kny391","type":"SolidColo