{"structure":{"type":"Page","styleId":"style-lvr1yx1m","metaData":{"sig":"9nr-397"},"id":"i0j36","components":[{"type":"Container","metaData":{"sig":"py2-1296"},"id":"comp-lvr1yx1s","components":[{"type":"Container","styleId":"strc1","metaData":{"sig":"9nr-389"},"id":"comp-lvr1yx21","components":[{"type":"Container","styleId":"mc1","metaData":{"sig":"py2-590"},"id":"comp-lvr1yx25","components":[{"type":"Component","styleId":"txtTheme","metaData":{"sig":"py2-558"},"id":"comp-lvr1yx272","dataQuery":"#dataItem-lvr1yx28","skin":"wysiwyg.viewer.skins.WRichTextThemeSkin","layout":{"width":752,"height":68,"x":113,"y":91,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvr1yx29","mobileHintsQuery":"mobileHints-lvr1yx2a","connectionQuery":"connection-lvr1yx2b","componentType":"wysiwyg.viewer.components.WRichText","sourceQuery":"source-lvr1yx2a1"}],"designQuery":"#dataItem-lvr1yx252","layout":{"width":980,"height":338,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvr1yx251","mobileHintsQuery":"mobileHints-lvr1yx27","connectionQuery":"connection-lvr1yx271","componentType":"wysiwyg.viewer.components.Column"}],"designQuery":"#dataItem-lvr1yx241","layout":{"width":1340,"height":338,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvr1yx24","mobileHintsQuery":"mobileHints-lvr1yx243","connectionQuery":"connection-lvr1yx244","componentType":"wysiwyg.viewer.components.StripColumnsContainer"},{"type":"Component","styleId":"txtTheme","metaData":{"sig":"py2-914"},"id":"comp-lvr1yx2b4","dataQuery":"#dataItem-lvr1yx2c","skin":"wysiwyg.viewer.skins.WRichTextThemeSkin","layout":{"width":541,"height":392,"x":14,"y":387,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvr1yx2c1","mobileHintsQuery":"mobileHints-lvr1yx2c2","connectionQuery":"connection-lvr1yx2c4","componentType":"wysiwyg.viewer.components.WRichText","sourceQue