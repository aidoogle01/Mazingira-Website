r1yx2t","componentType":"wysiwyg.viewer.components.Column"}],"designQuery":"#dataItem-lvr1yx2q7","layout":{"width":320,"height":50,"x":0,"y":2096,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvr1yx2q6","mobileHintsQuery":"mobileHints-lvr1yx2r","connectionQuery":"connection-lvr1yx2r1","componentType":"wysiwyg.viewer.components.StripColumnsContainer"}],"designQuery":"#dataItem-lvr1yx1z1","layout":{"width":320,"height":2147,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvr1yx1z","mobileHintsQuery":"mobileHints-lvr1yx3e","connectionQuery":"connection-lvr1yx201","anchorQuery":"anchors-lvr1yx20","componentType":"wysiwyg.viewer.components.ClassicSection"}],"mobileMetaData":{"sig":"9nr-396"},"dataQuery":"#i0j36","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1340,"height":2176,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"i0j36","mobileHintsQuery":"i0j36","connectionQuery":"i0j36","componentType":"mobile.core.components.Page","fixerVersionsQuery":"i0j36"},"data":{"document_data":{"dataItem-lvr1yx1d":{"type":"BackgroundMedia","id":"dataItem-lvr1yx1d","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"py2-53"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvr1yx1e":{"type":"BackgroundMedia","id":"dataItem-lvr1yx1e","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"py2-54"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvr1yx28":{"type":"StyledText","id":"dataItem-lvr1yx28","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"lso-230"},"text":"<h1 class=\"font_2\" style=\"font-size: 62px;\"><span style=\"font-size:62px;\"><span class=\"color_36\">Kilimanjaro National Park</span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr1yx2c":{"type":"StyledText","id":"dataItem-lvr1yx2c","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"py2-913"},"text":"<p class=\"font_8\"><span style=\"font-size: 22px;\">Explore the majestic Mount Kilimanjaro National Park</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">Renowned as a premier destination for mountain climbers and adventure enthusiasts, Mount Kilimanjaro National Park offers the unique experience of ascending the highest peak in Africa. This iconic mountain is home to diverse ecosystems, ranging from lush rainforests to alpine deserts, each hosting a variety of wildlife and breathtaking landscapes. The mountain&#39;s towering presence is visible from miles away, encapsulating approximately 1,688 square kilometers (about 652 square miles). As Tanzania&#39;s most famous national park for climbing, Kilimanjaro attracts thousands of climbers annually who come to challenge themselves and experience the profound beauty of its summit vistas. Explore our range of climbing packages and experience the thrill of reaching the roof of Africa on Mount Kilimanjaro.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr1yx2e":{"type":"ImageList","id":"dataItem-lvr1yx2e","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"py2-1339"},"items":["#dataItem-lvr2loe5","#dataItem-lvr2loe51","#dataItem-lvr2loe52","#dataItem-lvr2loe53","#dataItem-lvr2loe6","#dataItem-lvr2loe61"]},"dataItem-lvr1yx2h":{"type":"StyledText","id":"dataItem-lvr1yx2h","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"py2-1271"},"text":"<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px;\">Experiencing Kilimanjaro National Park</span></p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Offering a variety of unique activities centered around the mountain itself. Climbing Kilimanjaro is the most famous of these, providing adventurers with several routes to choose from, each offering different views and challenges. For those who prefer a less strenuous visit, short walks and day hikes in the lower altitudes still offer beautiful views and encounters with wildlife. The park also organizes cultural tours that allow visitors to engage with local Chagga communities, learning about their rich heritage and traditional ways of life. For the keen photographers and nature lovers, the park&#39;s diverse habitats and panoramic vistas provide endless opportunities for capturing stunning landscapes and the detailed intricacies of nature&rsquo;s artistry.</p>\n\n<p class=\"font_8\"><span style=\"text-decoration:underline;\"><span style=\"font-size:21px;\"></span></span><br />\n<span style=\"font-size:21px;\"><a ><span style=\"font-size:21px;\">In Kilimanjaro National Park</span></a></span></p>\n\n<p class=\"font_8\" style=\"font-size: 21px; line-height: 1.2em;\"><span style=\"font-size:16px;\">You can discover a breathtakingly diverse array of ecosystems as you ascend the slopes of the highest mountain in Africa. Starting from lush rainforests filled with towering trees and vocal wildlife, such as colobus monkeys and tropical birds, the scenery shifts as you climb higher. The forests give way to heath and moorland where giant lobelias and groundsel trees stand silhouetted against the sky, and higher still, the landscape transforms into a stark, otherworldly alpine desert before finally reaching the icy summit. Along the way, you might catch sight of rare animals like the Kilimanjaro tree hyrax and elusive leopards, making each zone not only a physical challenge but also a unique window into Africa&rsquo;s natural beauty.</span></p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr1yx2n":{"type":"Image","id":"dataItem-lvr1yx2n","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"w6r-0"},"title":"","uri":"1ac0ef_1d703aa0458843bcb4010e4ac6fab61e~mv2.png","description":"","width":756,"height":1507,"alt":"Note pad paper","crop":{"x":181,"y":0,"width":573,"height":1507,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"name":"Brown Vintage Blank Paper Torn Your Story-2.png"},"dataItem-lvr1yx2n6":{"type":"StyledText","id":"dataItem-lvr1yx2n6","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"py2-776"},"text":"<p class=\"font_8\" style=\"font-size: 26px;\"><span style=\"font-size:26px;\">IMPORTANT FACTS</span></p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">Mount Kilimanjaro National Park stands as a beacon for climbers and adventurers from around the world, celebrated not only for its majestic summit but also for its unique ecological system. The park is home to Mount Kilimanjaro, the highest mountain in Africa, which offers climbers several routes to its snowy peak, each varying in difficulty and scenic beauty.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size: 21px;\"><span style=\"font-size:21px;\">Most Prominent Wildlife:</span></p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Colobus Monkeys: Known for their striking black and white fur and long tails.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Blue Monkeys: Often seen in the montane forest.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Bushbabies: Nocturnal and elusive, adding a sense of mystery to night treks.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Elephants: Occasionally sighted at lower elevations in the park.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Buffaloes: Known to roam the moorland areas.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Leopards: Rare but captivating when spotted.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Various bird species: Including the Kilimanjaro white-eye, unique to the region.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\" style=\"font-size: 9px;\"><span style=\"font-size:9px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\" style=\"font-size: 21px;\"><span style=\"font-size:21px;\">Noteworthy Facts:</span></p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Varied Ecosystems: The park spans five main ecological zones from tropical rainforest to alpine desert, each offering distinct flora and fauna.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Glacial Features: Despite its equatorial location, the mountain&rsquo;s peaks are capped with snow and ice, with dramatic glaciers that are sadly receding.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Uhuru Peak: The highest point on the mountain, providing breathtaking views and a profound sense of accomplishment for those who reach it.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Shira Plateau: An expansive and elevated plateau, offering easier walks and stunning panoramas.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Mandara and Horombo Huts: Provide lodging for climbers along the Marangu Route, enhancing accessibility to various parts of the mountain.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Lava Tower: A famous volcanic rock formation that tests climbers&#39; acclimation to altitude.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Unique Climbing Experience: The opportunity to walk through several climate zones, from tropical to arctic, within a few days makes climbing Kilimanjaro a truly unique adventure.</p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr1yx2p4":{"type":"StyledText","id":"dataItem-lvr1yx2p4","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"py2-1307"},"text":"<p class=\"font_8\">TRAVEL TIME TO MOUNT KILIMANJARO NATIONAL PARK</p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Arusha to Kilimanjaro: Approximately 1.5 hours&#39; drive.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Moshi to Kilimanjaro: Just 45 minutes&#39; drive, as it&#39;s the closest major town to the park.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Dar es Salaam to Kilimanjaro: A long drive of about 8 hours, or a quick flight to Kilimanjaro International Airport taking about 1 hour</p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr2loe5":{"type":"Image","id":"dataItem-lvr2loe5","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"9he-1"},"title":"Blue Monkey","uri":"1ac0ef_01896ceb0f084ae88671b9887b4677f7~mv2.png","width":1242,"height":934,"alt":""},"dataItem-lvr2loe51":{"type":"Image","id":"dataItem-lvr2loe51","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"9he-2"},"title":"White Necked Raven","uri":"1ac0ef_958f463b8dc74730aafb5ab67a35cde2~mv2.png","width":1022,"height":878,"alt":""},"dataItem-lvr2loe52":{"type":"Image","id":"dataItem-lvr2loe52","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"9he-3"},"title":"Kilimanjaro Climb","uri":"1ac0ef_74a521a7edd84ebca928ed12b62877cc~mv2.png","width":922,"height":782,"alt":""},"dataItem-lvr2loe53":{"type":"Image","id":"dataItem-lvr2loe53","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"9he-4"},"title":"Columbo Mokeys","uri":"1ac0ef_afbefe3f9cbb42d0ba77ee2f34254358~mv2.png","width":846,"height":708,"alt":""},"dataItem-lvr2loe6":{"type":"Image","id":"dataItem-lvr2loe6","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"9he-5"},"title":"Elephant",