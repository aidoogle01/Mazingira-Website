ry":"propItem-lvp1a845","mobileHintsQuery":"mobileHints-lvp1a8451","connectionQuery":"connection-lvp1a8461","componentType":"wysiwyg.viewer.components.SiteButton"},{"type":"Component","styleId":"txtTheme","metaData":{"sig":"lgk-5114"},"id":"comp-lvp1a847","dataQuery":"#dataItem-lvp1a848","skin":"wysiwyg.viewer.skins.WRichTextThemeSkin","layout":{"width":280,"height":15,"x":6,"y":127,"scale":0.8,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvp1ddgd2","mobileHintsQuery":"mobileHints-lvp1a8482","connectionQuery":"connection-lvp1a849","componentType":"wysiwyg.viewer.components.WRichText","sourceQuery":"source-lvp1a8ie"}],"skin":"wysiwyg.viewer.skins.FormContainerSkin","layout":{"width":300,"height":153,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"mobileHintsQuery":"mobileHints-lvp1a83h","connectionQuery":"connection-lvp1a83j","componentType":"wysiwyg.viewer.components.FormContainer"}],"dataQuery":"#dataItem-lvp1a83d","layout":{"width":300,"height":153,"x":14,"y":11,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"mobileHintsQuery":"mobileHints-lvp1a83d1","connectionQuery":"connection-lvp1a83e","componentType":"platform.components.AppWidget"}],"designQuery":"#dataItem-lvp1a82s","layout":{"width":320,"height":168,"x":0,"y":1367,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvp1a82r","mobileHintsQuery":"mobileHints-lvp1a82u","connectionQuery":"connection-lvp1a836","anchorQuery":"anchors-lvp1a82v","componentType":"wysiwyg.viewer.components.ClassicSection","contentRoleQuery":"contentRole-lvp1a82w"}],"mobileMetaData":{"sig":"clz-237"},"dataQuery":"#z1olg","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1340,"height":1834,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvp0waca","mobileHintsQuery":"mobileHints-lvp0w87t","connectionQuery":"connection-lvp0w87x","componentType":"mobile.core.components.Page","fixerVersionsQuery":"z1olg"},"data":{"document_data":{"dataItem-lvp0w87h":{"type":"BackgroundMedia","id":"dataItem-lvp0w87h","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"a0o-1609"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvp0w87i":{"type":"BackgroundMedia","id":"dataItem-lvp0w87i","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"a0o-1610"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvp11ssv":{"type":"StyledText","id":"dataItem-lvp11ssv","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"orz-240"},"text":"<h1 class=\"font_2\" style=\"text-align: center;\"><span style=\"font-family:raleway,sans-serif;\"><span class=\"color_36\">Maasai Village Visits</span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp12mr9":{"type":"StyledText","id":"dataItem-lvp12mr9","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-2002"},"text":"<p class=\"font_8\">Explore the rich cultural heritage of Tanzania with an enriching visit to a traditional Maasai village, thoughtfully offered as an optional add-on by Mazingira Safaris. This unique excursion takes you off the beaten track to a Maasai community that preserves its age-old traditions and ways of life, far removed from more commercialized villages.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp13cni":{"type":"StyledText","id":"dataItem-lvp13cni","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"r8v-107"},"text":"<p class=\"font_5\">Visit The Traditional Maasai Villages </p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp152is":{"type":"StyledText","id":"dataItem-lvp152is","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-1953"},"text":"<p class=\"font_8\"><span style=\"font-size:20px;\">Why Add This Experience?</span><br />\nAdding a visit to a Maasai village to your Tanzanian safari offers a profound contrast to the wildlife-focused aspects of your trip. It enriches your travel experience by connecting you with the human element of this diverse country, deepening your understanding of its people and their heritage.</p>\n\n<p class=\"font_8\">This excursion is available for an additional fee, ensuring that it caters to those truly interested in engaging with and learning from the Maasai culture. It&#39;s an eye-opening addition that promises to enhance your safari with unforgettable memories and insights.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp15rmb":{"type":"Image","id":"dataItem-lvp15rmb","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"orz-248"},"title":"","uri":"1ac0ef_62c07be3b319424fabf5384e79ee40e6~mv2.png","description":"","width":700,"height":460,"alt":"Masai group preforming their local tribal dance a jumping competition between the males of the group.","name":"Screenshot 2024-05-01 at 21.35.16.png"},"dataItem-lvp16orq":{"type":"StyledText","id":"dataItem-lvp16orq","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-2030"},"text":"<p class=\"font_8\"><span style=\"font-size:20px\">Authentic Cultural Experience</span><br />\nUpon arrival, you&#39;ll be warmly welcomed by the Maasai, renowned for their vibrant clothing and intricate beadwork. You&#39;ll have the opportunity to don traditional Maasai garments, allowing for a deep dive into their culture. This hands-on approach helps you appreciate their customs and lifestyle authentically.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px\">Interactive Activities</span><br />\nYour visit is not just observational&mdash;it&#39;s an interactive immersion. Participate in Maasai dances, a central part of their cultural celebrations and communal gatherings. Learn the traditional art of fire-making, a skill essential to the Maasai way of life and passed down through generations. These activities offer a practical understanding of the Maasai&#39;s daily routines and survival techniques.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px\">Explore Traditional Living</span><br />\nDuring your tour, you&#39;ll explore the layout and structure of a Maasai village, including the enkang (homestead) and the manyatta (huts). See firsthand how the Maasai live, from their unique building techniques to their daily practices, providing a genuine glimpse into their enduring culture.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px\">Cultural Preservation and Respect</span><br />\nMazingira Safaris is committed to respectful and responsible tourism. This visit not only educates travelers about Maasai life but also supports the community, ensuring they benefit directly from our visits.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp17yqc":{"type":"Image","id":"dataItem-lvp17yqc","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"orz-247"},"title":"","uri":"1ac0ef_8208ee07f7ea49df861d465e2030454d~mv2.jpg","description":"","width":1179,"height":1225,"alt":"A Masai person guiding tourist to visit his Masai Village, in traditional Masai clothing ","name":"IMG_6933_edited.jpg"},"dataItem-lvp1a83d":{"type":"AppController","id":"dataItem-lvp1a83d","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-2203"},"applicationId":"14ce1214-b278-a7e4-1373-00cebd1bef7c","name":"wix-forms-controller","controllerType":"getSubscribers","externalId":""},"dataItem-lvp1a83l":{"type":"StyledText","i