nDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvp1il4v","mobileHintsQuery":"mobileHints-lvp1fwst","connectionQuery":"connection-lvp1fwso1","componentType":"wysiwyg.viewer.components.StripColumnsContainer"},{"type":"Component","styleId":"txtTheme","metaData":{"sig":"lgk-5301"},"id":"comp-lvp1hx9d","dataQuery":"#dataItem-lvp1hxad","skin":"wysiwyg.viewer.skins.WRichTextThemeSkin","layout":{"width":280,"height":910,"x":20,"y":105,"scale":0.625,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvp1hxjr","mobileHintsQuery":"mobileHints-lvp1hz7r","connectionQuery":"connection-lvp1hxak","componentType":"wysiwyg.viewer.components.WRichText","sourceQuery":"source-lvp1hxlm"},{"type":"Component","styleId":"wp2","metaData":{"sig":"lgk-5333"},"id":"comp-lvp2ah0s","dataQuery":"#dataItem-lvp2ah32","layout":{"width":256,"height":148,"x":31,"y":1018,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvp2ah35","mobileHintsQuery":"mobileHints-lvp2ak3o","connectionQuery":"connection-lvp2ah3h","componentType":"wysiwyg.viewer.components.WPhoto"}],"designQuery":"#dataItem-lvp1fghx","layout":{"width":320,"height":1179,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvp1fghw","mobileHintsQuery":"mobileHints-lvp1flcs","connectionQuery":"connection-lvp1fgi5","anchorQuery":"anchors-lvp1fghz","componentType":"wysiwyg.viewer.components.ClassicSection"}],"mobileMetaData":{"sig":"9nr-491"},"dataQuery":"#uzbra","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1340,"height":1672,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvp1esx4","mobileHintsQuery":"mobileHints-lvp1epao","connectionQuery":"connection-lvp1epas","componentType":"mobile.core.components.Page","fixerVersionsQuery":"uzbra"},"data":{"document_data":{"dataItem-lvp1epac":{"type":"BackgroundMedia","id":"dataItem-lvp1epac","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"a0o-2686"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvp1epad":{"type":"BackgroundMedia","id":"dataItem-lvp1epad","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"a0o-2687"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvp1h17b":{"type":"StyledText","id":"dataItem-lvp1h17b","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"orz-223"},"text":"<h1 class=\"font_4\" style=\"text-align: center; font-size: 62px;\"><span style=\"font-size:62px;\"><span style=\"font-family:raleway,sans-serif\"><span class=\"color_36\">Sunset Picnics</span></span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp1hxad":{"type":"StyledText","id":"dataItem-lvp1hxad","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-3043"},"text":"<p class=\"font_8\">Immerse yourself in the serene beauty of the Tanzanian wilderness with a romantic sunset picnic, meticulously curated by Mazingira Safaris to elevate your safari experience. As the sun sets over the majestic Serengeti, you and your loved one can enjoy a tranquil and intimate dining experience, surrounded by the breathtaking landscapes that make Tanzania a top safari destination.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px;\">Safety and Comfort in the Wilderness</span><br />\nYour safety and comfort are our utmost priorities. To ensure a secure environment, a knowledgeable Maasai guide will accompany you, offering both protection and fascinating insights into the local flora and fauna. The Maasai&#39;s presence enriches the experience, blending cultural heritage with the natural beauty of the bush.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px;\">Tailored to Your Preference</span><br />\nWe understand that each guest has unique comfort levels and preferences. For those who prefer not to stray far from the safety of a vehicle, we can arrange for the picnic to be set up within or near the truck. For the more adventurous spirits, a comfortable and scenic setup in the bush will provide an unobstructed view of the sunset, creating a truly immersive experience. All locations are carefully selected within a 20-minute drive from your accommodation, ensuring you spend more time enjoying the moment and less time traveling.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px;\">A Dining Experience Like No Other</span><br />\nAs the sky paints itself with the glorious colors of the African sunset, you will be treated to a hot food picnic featuring a mix of local and international cuisine. To cater to all preferences, we provide a selection of both alcoholic and non-alcoholic beverages. Cozy blankets are also provided, perfect for snuggling under as the evening air cools, adding an extra layer of comfort and romance to the setting.</p>\n\n<p class=\"font_8\" style=\"font-size: 20px;\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px;\">Why Add This to Your Trip?</span><br />\nAdding a sunset picnic to your safari trip offers a unique opportunity to create lasting memories with your partner. It&rsquo;s not just a meal; it&rsquo;s a moment to connect, to enjoy each other&#39;s company in one of the most stunning settings on earth. This experience combines the thrill of adventure with the intimacy of a quiet, private meal, making it an ideal choice for those looking to celebrate love, anniversaries, honeymoons, or simply the joy of shared experience.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">A sunset picnic with Mazingira Safaris isn&#39;t just another meal; it&#39;s a celebration of love, nature, and tranquility, all wrapped into one exclusive and memorable package. Whether you&#39;re watching the wildlife in the distance or gazing into a starlit sky, this experience promises to be as enchanting as it is unforgettable.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp2ah32":{"type":"Image","id":"dataItem-lvp2ah32","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"orz-228"},"title":"","uri":"1ac0ef_e84d5cade86740bfb20782a8427163ab~mv2.jpg","description":"","width":3354,"height":2587,"alt":"Sunsets in the Serengeti, a picnic arranged by Mazingira Safari  . picnics can be set up in the bush close to camps ","name":"P1040317.jpg"},"uzbra":{"type":"Page","id":"uzbra","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"04y-1"},"title":"Sunset Picnics","hideTitle":true,"icon":"","descriptionSEO":"Enhance your safari with a sunset picnic and nighttime game drive in Tarangire National Park or Lake Manyara. Discover nocturnal wildlife under the stars and experience the thrilling ambiance of the African night. Enjoy a unique perspective on the wilderness and its elusive creatures.","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"sunset-picnics","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":false,"indexable":true,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lvp1epac","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lvp1epad","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"advancedSeoData":"{\"tags\":[{\"type\":\"meta\",\"props\":{\"name\":\"description\",\"content\":\"Enhance your safari with a sunset picnic and nighttime game drive in Tarangire National Park or Lake Manyara. Discover nocturnal wildlife under the stars and experience the thrilling ambiance of the African night. Enjoy a unique p