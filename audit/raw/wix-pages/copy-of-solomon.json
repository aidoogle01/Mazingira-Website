positive feedback from my clients, which fills me with pride.</p>\n\n<p class=\"font_8\">I welcome you to Tanzania for the best wildlife safaris, cultural experiences, and more that this beautiful country offers. Karibuni!</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mn3":{"type":"Page","id":"x6mn3","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-3332"},"title":"Simon","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-solomon","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2p39xa","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2p39xc","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2p39xk1":{"type":"MediaContainerDesignData","id":"dataItem-lw2p39xk1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3312"},"background":"#dataItem-lw2p39xs","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lw2p39xs":{"type":"BackgroundMedia","id":"dataItem-lw2p39xs","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-3313"},"color":"#FFFFFF","colorOpacity":1.0,"alignType":"center","fittingType":"fill","scrollType":"none","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo","colorLayers":["#dataItem-lw2p39xs1"]},"dataItem-lw2p39xs1":{"id":"dataItem-lw2p39xs1","fill":{"type":"SolidColor","color":"{color_36}"},"opacity":0.88,"type":"SolidColorLayer","metaData":{"schemaVersion":"1.0","isPreset":false,"isHidden":false,"sig":"8wu-3314"}}},"behaviors_data":{"behavior-lw2p39xl1":{"type":"ObsoleteBehaviorsList","id":"behavior-lw2p39xl1","met