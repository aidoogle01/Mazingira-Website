layOpacity":0.0},"dataItem-lvl55crw":{"type":"Image","id":"dataItem-lvl55crw","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"fk2-12"},"title":"","uri":"nsplsh_6942c4e692dc4441b493d142c2ad5560~mv2.jpg","description":"","width":3008,"height":2000,"alt":"Image by Crispin Jones","crop":{"x":0,"y":220,"width":3008,"height":896,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"name":"Image by Crispin Jones"},"dataItem-lvl56s8d":{"type":"StyledText","id":"dataItem-lvl56s8d","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"r8v-150"},"text":"<h1 class=\"font_2\" style=\"text-align: center;\"><span class=\"color_36\">Kilimanjaro</span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvl57xwo":{"type":"StyledText","id":"dataItem-lvl57xwo","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"r8v-152"},"text":"<p class=\"font_3\" style=\"font-size: 30px; text-align: center;\"><span style=\"font-size:30px;\">Your Kilimanjaro Adventure</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvl5cd5r":{"type":"StyledText","id":"dataItem-lvl5cd5r","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"i5c-3294"},"text":"<p class=\"font_8\" style=\"line-height: normal; text-align: center; font-size: 19px;\"><span style=\"font-size:19px;\"><span style=\"letter-spacing:normal;\">Nestled within the Eastern Rift Mountains just south of the equator, Mount Kilimanjaro&#39;s majestic snow-capped peaks offer a stunning contrast to the expansive plains below. Known as the &quot;Roof of Africa,&quot; climbing Kilimanjaro&#39;s peak at 5,895 meters (19,341 feet) represents not only a physical challenge but also a profound journey that tests the limits of human endurance and spirit.</span></span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvl5d23n":{"type":"StyledText","id":"dataItem-lvl5d23n","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"i5c-3475"},"text":"<p class=\"font_8\" style=\"text-align:center\">For those seeking a transformative adventure coupled with the prestige of conquering Africa&rsquo;s highest mountain, consider integrating a Kilimanjaro climb into your East African safari with us. We recommend the less frequented Lemosho and Rongai routes for a more serene and picturesque experience. These paths offer a quieter, more intimate encounter with Kilimanjaro&#39;s diverse environments, away from the bustling crowds found on more popular routes. Our partnerships with top-tier operators and seasoned guides ensure a personalized and safe expedition in this awe-inspiring natural setting.</p>\n\n<p class=\"font_8\" style=\"text-align:center\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size: 19px;\"><span style=\"font-weight:bold;\"><span style=\"font-size:19px;\">About Kilimanjaro</span></span></p>\n\n<p class=\"font_8\" style=\"font-size: 19px;\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"text-align:center\">Kilimanjaro is a dormant volcano composed of three volcanic cones&mdash;Kibo, Mawenzi, and Shira&mdash;making it not only Africa&rsquo;s tallest peak but also the highest freestanding mountain globally. Unlike other renowned peaks among the Seven Summits, climbing Kilimanjaro does not require advanced technical mountaineering skills. However, it demands good physical fitness and preparation, as the climb is challenging. Most ascents span six to eight days, and we advise taking the longer duration to allow for better acclimatization to the varying altitudes and climates you&#39;ll encounter. Starting in the lush rainforest filled with rich flora and fauna, the ascent through five distinct climate zones culminates in the stark beauty of the summit&#39;s ice cap, offering climbers a truly unique and memorable experience.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvl5fou7":{"type":"StylableButton","id":"dataItem-lvl5fou7","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"w3q-1407"},"label":"ROUTES","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-lw2qak2i"},"dataItem-lvl5gsxs":{"type":"StylableButton","id":"dataItem-lvl5gsxs","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"w3q-3798"},"label":"SAMPLE ITINERARY","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-lvzeyesk"},"dataItem-lvl5kkuc":{"type":"Image","id":"dataItem-lvl5kkuc","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"fk2-13"},"title":"","uri":"nsplsh_445758522d6e416278436b~mv2_d_3043_2036_s_2.jpg","description":"","width":3043,"height":2036,"alt":"Image by Sergey Pesterev","crop":{"x":0,"y":735,"width":3043,"height":856,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"name":"Image by Sergey Pesterev"},"dataItem-lvl5m3ne":{"type":"StyledText","id":"dataItem-lvl5m3ne","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"r8v-154"},"text":"<p class=\"font_3\"><span class=\"color_36\">Start your Kilimanjaro Adventure Now</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvl5n0kh":{"type":"StylableButton","id":"dataItem-lvl5n0kh","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"zqf-3626"},"label":"ENQUIRE NOW","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-lw7trib9"},"dataItem-lvzeyesk":{"type":"PageLink","id":"dataItem-lvzeyesk","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wtw-7389"},"pageId":"#sd16h","target":"_self","rel":[]},"dataItem-lw2qak2i":{"type":"PageLink","id":"dataItem-lw2qak2i","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"w3q-1408"},"pageId":"#fltnm","target":"_self"},"dataItem-lw2rh10g":{"type":"StylableButton","id":"dataItem-lw2rh10g","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidd