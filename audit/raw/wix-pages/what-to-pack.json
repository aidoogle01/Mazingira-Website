"componentType":"wysiwyg.viewer.components.WRichText","sourceQuery":"source-lvnqugig"},{"type":"Component","styleId":"wp2","metaData":{"sig":"lgk-10769"},"id":"comp-lvnqtz0b","dataQuery":"#dataItem-lvnqtz4a","layout":{"width":257,"height":170,"x":31,"y":2392,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvnqtz4b","mobileHintsQuery":"mobileHints-lvnqu3cw","connectionQuery":"connection-lvnqtz4n","componentType":"wysiwyg.viewer.components.WPhoto"}],"designQuery":"#dataItem-lvgtuaeh1","layout":{"width":320,"height":2580,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvgtuaeh","mobileHintsQuery":"mobileHints-lw7p71tp","connectionQuery":"connection-lvgtuael","anchorQuery":"anchors-lvgtuaei","componentType":"wysiwyg.viewer.components.ClassicSection"}],"mobileMetaData":{"sig":"9nr-732"},"dataQuery":"#ukbp8","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1340,"height":2758,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvgtu9sn","mobileHintsQuery":"mobileHints-lvgtu6jl","connectionQuery":"connection-lvgtu6jo","componentType":"mobile.core.components.Page","fixerVersionsQuery":"ukbp8"},"data":{"document_data":{"dataItem-lvgtu6jf":{"type":"BackgroundMedia","id":"dataItem-lvgtu6jf","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"dx3-3573"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvgtu6jf1":{"type":"BackgroundMedia","id":"dataItem-lvgtu6jf1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"dx3-3574"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvnqfke8":{"type":"StyledText","id":"dataItem-lvnqfke8","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"r8v-404"},"text":"<h1 class=\"font_4\" style=\"font-size:68px\"><span style=\"font-size:68px\"><span class=\"color_36\">Packing Tips For Safari</span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnqh0f0":{"type":"StyledText","id":"dataItem-lvnqh0f0","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"oqg-6859"},"text":"<h3 class=\"font_3\" style=\"font-size:30px\"><span style=\"font-size:30px\">What to Pack for a Safari in Tanzania: Essentials &amp; Tips for a Zanzibar Add-On</span></h3>\n\n<h3 class=\"font_3\"><span class=\"wixGuard\">​</span></h3>\n\n<p class=\"font_8\">Embarking on a safari in Tanzania offers a chance to witness the breathtaking beauty and diverse wildlife of Africa. Whether you&#39;re planning to traverse the vast plains of the Serengeti or ascend the heights of Mount Kilimanjaro, packing the right items is crucial for a comfortable and successful adventure. Here&rsquo;s your ultimate guide to packing for a safari in Tanzania, with a bonus section for those extending their trip to the tropical paradise of Zanzibar.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<h4 class=\"font_4\" style=\"font-size:28px\"><span style=\"font-size:28px\">Essential Safari Packing List</span></h4>\n\n<h4 class=\"font_4\" style=\"font-size:26px\"><span style=\"font-size:26px\"><span class=\"wixGuard\">​</span></span></h4>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">1. Clothing:</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Lightweight, Breathable Fabrics: Opt for neutral colors (tan, brown, khaki, olive) to blend with the natural environment and avoid attracting insects.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Long Sleeves and Pants: These protect against the sun and insects, especially mosquitoes that are prevalent at dawn and dusk.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Warm Layers: Nights and early mornings can be chilly, especially at higher altitudes or during the cooler months. Include a warm fleece or jacket.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Rain Gear: A lightweight waterproof jacket will come in handy during the rainy season.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">2. Footwear:</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Sturdy Walking Shoes: A comfortable pair of hiking boots or walking shoes is essential for those walking safaris or any extensive walking.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Sandals: For more casual wear around the camp or lodge.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">3. Gear and Equipment:</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Binoculars: Enhance your wildlife viewing experience with a good pair of binoculars.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Camera Equipment: Bring a camera with a good zoom lens to capture distant wildlife, along with extra batteries and memory cards.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Sun Protection: Pack sunglasses, a wide-brimmed hat, and high SPF sunscreen to protect against the strong African sun.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Insect Repellent: Essential for protecting against mosquito bites, which can transmit diseases such as malaria.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">4. Health and Safety:</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">First Aid Kit: Include basic supplies and any personal medications. Anti-diarrheal medications and electrolytes are useful for stomach upsets.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Travel Insurance Information: Always carry information about your travel insurance.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">5. Miscellaneous:</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Daypack: For carrying essentials during game drives or short walks.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Reusable Water Bottle: Stay hydrated without increasing plastic waste.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Guidebooks and Wildlife Guides: Enhance your understanding and enjoyment of the environments and animals you are observing.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<h4 class=\"font_4\" style=\"font-size:28px\"><span style=\"font-size:28px\">Importance of Packing Light</span></h4>\n\n<h4 class=\"font_4\" style=\"font-size:23px\"><span style=\"font-size:23px\"><span class=\"wixGuard\">​</span></span></h4>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">Why Pack Light?</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Mobility: Lighter packs make moving through airports, transferring between vehicles and lodges, and managing your belongings on game drives much easier.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Flight Restrictions: Many safari flights have strict weight limits, typically around 15kg per person for checked luggage. Overpacking can lead to extra fees or the inconvenience of leaving items behind.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Simplicity: Fewer items mean less to worry about. Simplifying your gear lets you focus more on the experience than managing your belongings.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\"><span style=\"font-weight:bold\">Advantages of a Hiking Backpack:</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Flexibility: Hiking backpacks are easier to fit into small spaces like overhead compartments or safari vehicles, compared to hard-sided luggage.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Comfort: Adjustable straps and designed ergonomics make carrying a backpack more comfortable over distances or uneven terrain.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Accessibility: Quick access to pockets and compartments can be invaluable during transit or when you need to grab items on the go.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<h4 class=\"font_4\" style=\"font-size:28px\"><span class=\"wixGuard\">​</span></h4>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnqluep":{"type":"Image","id":"dataItem-lvnqluep","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"ejb-0"},"title":"","uri":"1ac0ef_f81a1bed614f4bfcb8170ee978107f74~mv2.png","description":"","width":1080,"height":1080,"alt":"Why pack light for Safari image","name":"3.png"},"dataItem-lvnqluf7":{"type":"Image","id":"dataItem-lvnqluf7","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"r8v-409"},"title":"","uri":"1ac0ef_c415bb8f1f734d25b750646073a8b04a~mv2.png","description":"","width":1080,"height":1080,"alt":"Why pack light for Safari image","name":"1.png"},"dataItem-lvnqoqoa":{"type":"Image","id":"dataItem-lvnqoqoa","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"ejb-1"},"title":"","uri":"1ac0ef_fb916289cf1b40bca0af451dfdb5e51b~mv2.png","description":"","width":1080,"height":1080,"alt":"Why pack light for Safari image","name":"2.png"},"dataItem-lvnqtz4a":{"type":"Image","id":"dataItem-lvnqtz4a","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"ejb-2"},"title":"","uri":"nsplsh_6550655473716379556949~mv2_d_4096_2640_s_4_2.jpg","description":"","width":4096,"height":2640,"alt":"Zanzibars white beaches and blue seas are show at the edge of the island ","name":"Image by Med J"},"dataItem-lvnqufob":{"type":"StyledText","id":"dataItem-lvnqufob","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"oqg-6929"},"text":"<h4 class=\"font_4\" style=\"font-size:28px\"><span style=\"font-size:28px\">Bonus Item: What to Pack for a Zanzibar Add-On</span></h4>\n\n<h4 class=\"font_4\" style=\"font-size:28px\"><span style=\"font-size:28px\"><span class=\"wixGuard\">​</span></span></h4>\n\n<p class=\"font_8\">After your safari, if you&#39;re heading to Zanzibar, you&rsquo;ll want to adapt your packing list for the beach and historical explorations:</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Swimwear: Essential for enjoying the beautiful beaches.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Light, Airy Clothing: Perfect for the hot and humid climate. Include a few conservative options for visiting Stone Town, where modesty is appreciated.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Flip Flops and Water Shoes: Ideal for sandy beaches and exploring the coral reefs.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Snorkeling Gear: Bring your own if you prefer to use equipment that fits you well.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Cover-Up or Sarong: Useful for beach lounging and as an additional layer of sun protection.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<h4 class=\"font_4\" style=\"font-size:28px\"><span style=\"font-size:28px\">Final Thoughts</span></h4>\n\n<h4 class=\"font_4\" style=\"font-size:22px\"><span style=\"font-size:22px\"><span class=\"wixGuard\">​</span></span></h4>\n\n<p class=\"font_8\">Packing effectively for a Tanzanian safari and a Zanzibar getaway involves preparing for a variety of activities and climates. By covering the essentials listed above and packing lightly in a versatile backpack, you&rsquo;ll be well-equipped to enjoy every moment of your African adventure, from the wild savannahs to the serene beaches of Zanzibar. Happy travels!</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"ukbp8":{"type":"Page","id":"ukbp8","metaD