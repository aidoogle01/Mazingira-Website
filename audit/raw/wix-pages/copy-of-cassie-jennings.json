schemaVersion":"2.0","isHidden":false,"sig":"8wu-2753"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2orm61":{"type":"BackgroundMedia","id":"dataItem-lw2orm61","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2756"},"mediaRef":"#dataItem-lw2orm611","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2orm611":{"type":"Image","id":"dataItem-lw2orm611","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-2755"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2orm6k":{"type":"SvgShape","id":"dataItem-lw2orm6k","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2775"}},"dataItem-lw2orm6l2":{"type":"StyledText","id":"dataItem-lw2orm6l2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2822"},"text":"<p class=\"font_8\">I am Goodluck Nathan, born and educated in Arusha. As one of the youngest guides from the Meru tribe living along the slopes of Mount Meru in the Arusha region, I developed a love for the outdoors and a deep appreciation for the environment at an early age. Growing up with my uncle, who was a tour guide and conservationist, further inspired me.</p>\n\n<p class=\"font_8\">In 2015, I began my journey to become a tour guide, focusing on bird identification, habits, and habitats for four years. In 2019, I enrolled in a tour guiding college and earned a diploma in tourism and hospitality in 2021. I initially worked as a transfer guide, leading activities around the Arusha and Kilimanjaro regions.</p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">To enhance my skills, I trained for a year as a game package guide in the Mara River area. After completing my training, I joined Mazingira Safari as a full-time safari guide. I thoroughly enjoy nature, particularly birding.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mmy":{"type":"Page","id":"x6mmy","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-2812"},"title":"Goodluck Nathan","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-cassie-jennings","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2orm5z","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2orm61","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2orm6g1":{"type":"MediaContainerDesignData","id":"dataItem-lw2orm6g1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2792"},"background":"#dataItem-lw2orm6o","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lw2orm6o":{"type":"BackgroundMedia","id":"dataItem-lw2orm6o","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2793"},"color":"#FFFFFF","colorOpacity":1.0,"alignType":"center","fittingType":"fill","scrollType":"none","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo","colorLayers":["#dataItem-lw2orm6o1"]},"dataItem-lw2orm6o1":{"id":"dataItem-lw2orm6o1","fill":{"type":"SolidColor","color":"{color_36}"},"opacity":0.88,"type":"SolidColorLayer","metaData":{"schemaVersion":"