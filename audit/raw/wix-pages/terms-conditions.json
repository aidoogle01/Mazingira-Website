","mobileHintsQuery":"mobileHints-lvpcywhm","connectionQuery":"connection-lvp4me6s","anchorQuery":"anchors-lvp4me6m","componentType":"wysiwyg.viewer.components.ClassicSection"}],"mobileMetaData":{"sig":"cmo-201"},"dataQuery":"#ktpyq","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1039,"height":1952,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvp4mdnx","mobileHintsQuery":"mobileHints-lvp4majo","connectionQuery":"connection-lvp4majw","componentType":"mobile.core.components.Page","fixerVersionsQuery":"ktpyq"},"data":{"document_data":{"dataItem-lvp4maj7":{"type":"BackgroundMedia","id":"dataItem-lvp4maj7","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"a0o-5077"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvp4maj9":{"type":"BackgroundMedia","id":"dataItem-lvp4maj9","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"a0o-5078"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvp4prj3":{"type":"StyledText","id":"dataItem-lvp4prj3","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"cmo-211"},"text":"<h1 class=\"font_4\" style=\"text-align: center;\"><span style=\"font-family:raleway,sans-serif;\"><span style=\"color:#FFFFFF;\">Payment Terms &amp; Conditions</span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp4rkgg":{"type":"StyledText","id":"dataItem-lvp4rkgg","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-5446"},"text":"<p class=\"font_8\">Booking and Payment Terms for Mazingira Safaris</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Booking Confirmation:</p>\n\n<p class=\"font_8\">To confirm your booking, please provide confirmation either via email to Mazingira Safaris or directly through our itinerary form, which links directly to the payment page. This confirmation must be in writing to ensure clarity and mutual understanding of the booking details.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Payment Methods:</p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Online Payment Portal: Payments can be made securely through our online payment portal using either credit or debit card.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Bank Transfer: Alternatively, payments can be made via bank transfer using the following details:</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Bank Details:</p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Account Name: LOCAL SAFARI GUIDE PROMOTION LTD</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Account Number: 42810007985 (USD Account)</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Bank Name: NATIONAL MICROFINANCE BANK PLC</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">SWIFT Code: NMIBTZTZ</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Branch: NMB BANK ARUSHA BUSINESS CENTER</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Address: P.O.Box 9213 ARUSHA</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Payment Schedule:</p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">30% deposit to secure the booking.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">An additional 40% is due 8 weeks prior to travel.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">The remaining 30% must be paid 30 days before the tour begins.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\t</li>\n</ul>\n\n<p class=\"font_8\">Please ensure timely payments to secure your reservation. Late payments will result in cancellation of the booking and loss of deposit. Early bookings are encouraged to guarantee availability.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Payments from overseas and non-residents of Tanzania should be made in US Dollars. Residents of Tanzania may pay in the local currency at the current exchange rate at the time of payment. Mazingira Safaris reserves the right to withhold services if payments are not made according to the specified conditions.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Safari Pricing:</p>\n\n<p class=\"font_8\">Prices are quoted in US Dollars per person, based on double occupancy, and include full board during safari days. Pricing for a private safari with two people includes a private vehicle and guide. Prices vary depending on the choice of lodges and camps, the season, and the specific dates of your trip. Our prices exclude international flights but include all transfers, internal flights, and land arrangements. Departures are guaranteed without the need to join fixed groups.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">When planning your budget, please communicate your financial considerations clearly to your Mazingira Safaris consultant. Let us know your preferred safari program, and we will provide a detailed itinerary and our best quotation tailored to your budget and requirements.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Late Bookings:</p>\n\n<p class=\"font_8\">For reservations made within 40 days prior to the commencement of the safari, full payment is required at the time of booking.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Cancellation Policy:</p>\n\n<p class=\"font_8\">To cancel a confirmed booking, notification must be made in writing to Mazingira Safaris. The following cancellation fees will apply from the date your written notification is received:</p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">More than 61 days prior to departure: 20% of the package price.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">60 to 45 days prior to departure: 50% of the package price.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">44 to 31 days prior to departure: 70% of the package price.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">30 days or less prior to departure or after the safari has commenced: 100% of the package price; no refunds will be issued for cancellations made within this period or once the safari has started.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Important Information:</p>\n\n<p class=\"font_8\">There are no refunds for any unused portion of the safari once it has commenced. Cancellation penalties or additional costs incurred from changes in airline schedules or airfares are not included in the above cancellation fees and must be handled directly with the involved airlines. We recommend purchasing cancellation insurance to cover the total cost of the safari.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">For any inquiries or further assistance, please contact us at info@mazingirasafari.com.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"ktpyq":{"type":"Page","id":"ktpyq","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"vhc-1"},"title":"Terms & Conditions","hideTitle":true,"icon":"","descriptionSEO":"Learn about the booking and payment terms for Mazingira Safaris. Find detailed information on our reservation process, payment methods, cancellation policies, and other essential terms to ensure a smooth and transparent safari booking experience","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"terms-conditions","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":false,"indexable":true,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lvp4maj7","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lvp4maj9","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"advancedSeoData":"{\"tags\":[{\"type\":\"meta\