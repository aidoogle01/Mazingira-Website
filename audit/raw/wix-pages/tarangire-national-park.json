Type":"wysiwyg.viewer.components.Column"}],"designQuery":"#dataItem-lvqot5bg3","layout":{"width":320,"height":50,"x":0,"y":1645,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvqot5bg2","mobileHintsQuery":"mobileHints-lvqot5bg5","connectionQuery":"connection-lvqot5bg6","componentType":"wysiwyg.viewer.components.StripColumnsContainer"}],"designQuery":"#dataItem-lvqot5am","layout":{"width":320,"height":1695,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvqot5al","mobileHintsQuery":"mobileHints-lvqot5c5","connectionQuery":"connection-lvqot5an","anchorQuery":"anchors-lvqot5am2","componentType":"wysiwyg.viewer.components.ClassicSection"}],"mobileMetaData":{"sig":"9nr-436"},"dataQuery":"#q0r3h","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1340,"height":1771,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"q0r3h","mobileHintsQuery":"q0r3h","connectionQuery":"q0r3h","componentType":"mobile.core.components.Page","fixerVersionsQuery":"q0r3h"},"data":{"document_data":{"dataItem-lvqot59s":{"type":"BackgroundMedia","id":"dataItem-lvqot59s","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"m7a-261"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvqot59t":{"type":"BackgroundMedia","id":"dataItem-lvqot59t","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"m7a-262"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvqot5aw":{"type":"StyledText","id":"dataItem-lvqot5aw","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"lso-281"},"text":"<h1 class=\"font_2\"><span class=\"color_36\">Tarangire National Park</span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvqot5b1":{"type":"StyledText","id":"dataItem-lvqot5b1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"lgk-3241"},"text":"<p class=\"font_7\" style=\"font-size:25px\"><span style=\"font-size:25px\">Explore the iconic Tarangire National Park&nbsp;</span></p>\n\n<p class=\"font_7\" style=\"font-size: 16px; line-height: normal;\"><span style=\"font-size:16px\">Tarangire National Park is renowned for its iconic Baobab trees, which tower over the landscape with their massive trunks and distinctive silhouettes. This park is particularly celebrated for hosting the world&#39;s highest density of elephants. Visitors can often spot herds of up to 300 elephants congregating around the Tarangire River, the park&#39;s vital lifeline. During the dry season, this river becomes a hub of activity as wildlife gathers to drink, bathe, and escape the sweltering heat. Remarkably, towards the end of the dry season, elephants can be observed digging into the parched riverbed to access underground streams, or seeking out Baobab trees to quench their thirst.</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvqot5b3":{"type":"ImageList","id":"dataItem-lvqot5b3","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"h92-170"},"items":["#dataItem-lvqpjs04","#dataItem-lvqpjs041","#dataItem-lvqpjs042","#dataItem-lvqpjs05","#dataItem-lvqpjs051","#dataItem-lvqpjs052","#dataItem-lvqpjs053","#dataItem-lvqpjs054","#dataItem-lvqpjs055","#dataItem-lvqpjs056"]},"dataItem-lvqot5b53":{"type":"StyledText","id":"dataItem-lvqot5b53","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"h92-836"},"text":"<h2 class=\"font_2\" style=\"font-size: 24px;\"><span style=\"font-size:24px;\">ELEPHANT PARADISE</span></h2>\n\n<h2 class=\"font_2\" style=\"font-size: 15px;\"><span style=\"font-size:15px;\"><span class=\"wixGuard\">​</span></span></h2>\n\n<p class=\"font_8\">Apart from elephants, Tarangire is a paradise for bird lovers. From parrots, hornbills, lovebirds and lilac breasted rollers to Kori bustards, eagles and vultures. The swamps in Tarangire National Park have one of the largest number of breeding bird species in the world. In the area around these swamps you can also see lions, leopards, cheetahs and even tree-climbing pythons.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<h2 class=\"font_2\" style=\"font-size: 24px;\"><span style=\"font-size:24px;\">AUTHENTIC ATMOSPHERE OF TARANGIRE</span></h2>\n\n<h2 class=\"font_2\" style=\"font-size: 16px;\"><span style=\"font-size:16px;\"><span class=\"wixGuard\">​</span></span></h2>\n\n<p class=\"font_8\">Tarangire is one less known parks in Tanzania, but it still has an authentic safari atmosphere. The hilly landscape scattered with huge Baobab trees against the blue sky is breathtaking.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvqot5bb":{"type":"Image","id":"dataItem-lvqot5bb","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"1wb-0"},"title":"","uri":"1ac0ef_1d703aa0458843bcb4010e4ac6fab61e~mv2.png","description":"","width":756,"height":1507,"alt":"note pad","crop":{"x":181,"y":0,"width":573,"height":1507,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"name":"Brown Vintage Blank Paper Torn Your Story-2.png"},"dataItem-lvqot5bc2":{"type":"StyledText","id":"dataItem-lvqot5bc2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"h92-667"},"text":"<p class=\"font_8\" style=\"font-size:26px\"><span style=\"font-size:26px\">IMPORTANT FACTS</span></p>\n\n<p class=\"font_8\" style=\"font-size:8px\"><span style=\"font-size:8px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">Tarangire National Park is a standout wildlife destination in Tanzania, renowned for its large elephant herds and the majestic baobab trees that dot its expansive landscape. This park offers the opportunity to witness diverse wildlife in their natural habitat.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Prominent Wildlife:</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Elephants: Famous for its large elephant population, Tarangire offers exceptional opportunities to observe these majestic animals in the wild.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Baobab Trees: The iconic baobab trees are not only a striking feature of the landscape but also play a critical role in the local ecosystem.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Zebras and Wildebeest: These animals are commonly seen wandering the park</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Lions: These predators are frequently spotted lounging under shade or hunting across the savannah.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Giraffes: The park&#39;s tall acacia and baobab trees provide the perfect feeding grounds for giraffes,&nbsp;</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Buffaloes: Often found in large herds, buffaloes are a significant part of the park&#39;s wildlife diversity.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Bird Species: With over 300 bird species, Tarangire is a bird watcher&#39;s paradise.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Noteworthy Facts :</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Tarangire River: This vital water source attracts a wide range of wildlife, making it a hotspot for game viewing, especially in the dry season.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Migration Patterns: Tarangire witnesses its own migration of wildebeest and zebras, which is quite spectacular.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Diverse Landscapes: The park features a mix of granitic ridges, river valleys, and swamps.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Dry Season Concentration: Tarangire is known for the dramatic concentration of wildlife during the dry season</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Ancient Baobab Trees: Some of the baobabs in Tarangire are centuries old and serve as natural reservoirs, storing water in their trunks during the rainy season.</p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvqot5bf1":{"type":"StyledText","id":"dataItem-lvqot5bf1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"h92-716"},"text":"<h2 class=\"font_2\" style=\"font-size: 24px;\"><span style=\"font-size:24px;\">TRAVEL TIME TO TARANGIRE</span></h2>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Arusha to Tarangire National Park: 2,5 hours&rsquo; drive</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Tarangire to Lake Manyara National Park: 1 hour drive.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Tarangire to Ngorongoro Conservation Area: 2 hours&rsquo; drive.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Tarangire to Serengeti National Park: 4 hours drive.</p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvqpjs04":{"type":"Image","id":"dataItem-lvqpjs04","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"4bs-0"},"title":"Elephants in Tarangire","uri":"1ac0ef_d1a13c9e92484d98b32404ed49fb8433~mv2.jpg","width":4000,"height":3000,"alt":""},"dataItem-lvqpjs041":{"type":"Image","id":"dataItem-lvqpjs041","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"4bs-1"},"title":"Giraffe","uri":"1ac0ef_7f4ff8517c524ae081890d16d0624e48~mv2.jpg","width":4000,"height":3000,"alt":""},"dataItem-lvqpjs042":{"type":"Image","id":"dataI