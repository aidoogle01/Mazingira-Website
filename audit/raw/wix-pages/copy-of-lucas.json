,"isHidden":false,"sig":"ta6-81"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lwkeh6fl":{"type":"BackgroundMedia","id":"dataItem-lwkeh6fl","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"ta6-84"},"mediaRef":"#dataItem-lwkeh6fm","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lwkeh6fm":{"type":"Image","id":"dataItem-lwkeh6fm","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"ta6-83"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lwkeh6gh":{"type":"SvgShape","id":"dataItem-lwkeh6gh","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"ta6-103"}},"dataItem-lwkeh6gk":{"type":"StyledText","id":"dataItem-lwkeh6gk","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"ta6-152"},"text":"<p class=\"font_8\">I was born at the base of Mount Meru near Arusha National Park. When I was in primary school, I used to visit Arusha National Park regularly as part of outreach programs for the local community. These visits sparked my fascination with birds, especially the flamingos in Lake Momela, as well as various animals and waterfalls. My relatives were pioneers in tourism, and I grew up watching my uncles work as tour guides and with large tour companies. This exposure instilled in me a deep love for everything related to tourism.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\">After completing my secondary education, I went to college and graduated with a certificate in Education. I worked as a teacher in several schools, but my passion for tourism remained strong. To pursue this passion, I took a short course in Tourism and Accounts. No challenge was too great for me to take on while staying focused on my vision.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\">I joined Mazingira Safaris as an Accountant, where I oversee daily office operations, including accounts, manage safari guides, and handle all other logistics.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mn5":{"type":"Page","id":"x6mn5","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"ta6-140"},"title":"Anna Abraham","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-lucas","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lwkeh6fg","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lwkeh6fl","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lwkeh6g81":{"type":"MediaContainerDesignData","id":"dataItem-lwkeh6g81","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"ta6-120"},"background":"#dataItem-lwkeh6go","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lwkeh6go":{"type":"BackgroundMedia","id":"dataItem-lwkeh6go","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"ta6-121"},"color":"#FFFFFF","colorOpacity":1.0,"alignType":"center","fittingType":"fill","scrollType":"none","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo","colorLayers":["#dataItem-lwkeh6go1"]},"dataItem-lwkeh6go1":{"id":"dataItem-lwkeh6go1","fill":{"type":"SolidColor","color":"{c