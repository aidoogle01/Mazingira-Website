taItem-lvnsc8rz":{"type":"BackgroundMedia","id":"dataItem-lvnsc8rz","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"oqg-7906"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvnsc8s5":{"type":"BackgroundMedia","id":"dataItem-lvnsc8s5","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"oqg-7907"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvnsr1mp":{"type":"StyledText","id":"dataItem-lvnsr1mp","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"orz-295"},"text":"<h1 class=\"font_2\" style=\"text-align: center;\"><span class=\"color_36\">Night Time Game Drives</span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnsxxfp":{"type":"StyledText","id":"dataItem-lvnsxxfp","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-5390"},"text":"<p class=\"font_8\" style=\"text-align:center\"><span style=\"font-size:36px\">Beneath the vast African night sky, the darkness unveils a hidden world of shy and elusive nocturnal creatures</span>.</p>\n\n<p class=\"font_8\" style=\"text-align:center\">&nbsp;</p>\n\n<p class=\"font_8\">A night safari drive is an exhilarating experience, offering a fresh and thrilling perspective on wildlife viewing. As daylight fades, your heightened senses tune into the mysterious sounds and movements of the night, guided by the sweep of your guide&#39;s powerful spotlight across the bush in search of reflective eyes.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\">Spotting Africa&#39;s nocturnal animals, like lions, leopards, hyenas, wild dogs, and other less-seen nocturnal species, is a rare treat. These creatures come alive in the cooler night conditions, and seeing their eyes glow under the red-filtered spotlight offers a starkly different and eerie experience compared to daytime safaris.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\">During the drive, you might spot owls, nightjars, chameleons, and bush babies in their natural habitats, sometimes catching the quiet drama of an owl capturing its prey. The absence of light pollution allows the stars of the East African sky to shine brightly, with your guide pointing out constellations and galaxies, adding an educational layer to your adventure.</p>\n\n<p class=\"font_8\">A safari night drive is not just an outing; it&rsquo;s an immersive journey into the nocturnal heart of the wilderness, making it a must-experience activity for anyone visiting the region.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnt1txi":{"type":"StyledText","id":"dataItem-lvnt1txi","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-5385"},"text":"<h2 class=\"font_2\" style=\"font-size:44px\"><span style=\"font-size:44px\"><span class=\"color_36\"><span style=\"font-family:raleway,sans-serif\">Have a unique adventure in mind? Let&rsquo;s help you plan</span></span></span></h2>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnt3pw5":{"type":"StylableButton","id":"dataItem-lvnt3pw5","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"rhy-157"},"label":"ENQUIRE NOW","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-lwe1gghi"},"dataItem-lvpthd1t":{"type":"ImageList","id":"dataItem-lvpthd1t","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-5554"},"items":["#dataItem-lvptoh9z","#dataItem-lvptoh9z1","#dataItem-lvptoh9z2","#dataItem-lvptoh9z3","#dataItem-lvptoh9z4","#dataItem-lvptoh9z5","#dataItem-lvptoha0","#dataItem-lvptoha01","#dataItem-lvptoha02"]},"dataItem-lvptoh9z":{"type":"Image","id":"dataItem-lvptoh9z","metaData":{"isPreset":false,"schemaVersion":"2.0","