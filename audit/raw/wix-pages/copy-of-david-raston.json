Version":"2.0","isHidden":false,"sig":"8wu-755"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2n4q1i":{"type":"BackgroundMedia","id":"dataItem-lw2n4q1i","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-758"},"mediaRef":"#dataItem-lw2n4q1i1","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2n4q1i1":{"type":"Image","id":"dataItem-lw2n4q1i1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-757"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2n4q1t":{"type":"SvgShape","id":"dataItem-lw2n4q1t","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-777"}},"dataItem-lw2n4q1v":{"type":"StyledText","id":"dataItem-lw2n4q1v","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"671-1194"},"text":"<p class=\"font_8\">Hi Im, Cassie the UK Sales and safari specialist for Mazingira Safari&rsquo;s , and my journey with this incredible company started in 2023 when I embarked on a personal safari adventure in Tanzania. The breathtaking landscapes, the warmth of the local people, and the exceptional service provided by Mazingira Safari&#39;s instantly captured my heart. It was an experience so profound that it inspired me and my husband to forge a deeper connection with this beautiful country.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">Seizing an opportunity to share this love, we began building a partnership with Mazingira Safari&#39;s to establish a sales hub in the UK. This venture allows us to bring the magic of Tanzanian safari&#39;s closer to Europe, offering tailored safari packages designed to showcase the wonders of Tanzania.</p>\n\n<p class=\"font_8\"><span class=\"inherit-font-size\" style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">With a growing expertise in safari operations, wildlife, and local cultures, I am thrilled to share my knowledge and experiences. Alongside my wonderful team based in Tanzania, I am here to help you plan your dream safari. My goal is to enlighten others in the UK and beyond about Tanzania&rsquo;s enchanting beauty and to help them discover their own unforgettable safari adventures. Join us to explore this wonderful place and create memories that will last a lifetime.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mmx":{"type":"Page","id":"x6mmx","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-2685"},"title":"Cassie Jennings","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-david-raston","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2n4q1f","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2n4q1i","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2n4q1q1":{"type":"MediaContainerDesignData","id":"dataItem-lw2n4q1q1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-794"},"background":"#dataItem-lw2n4q1x2","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lw2n4q1x2":{"type":"BackgroundMedia","id":"dataItem-lw2n4q1x2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-795"},"color":