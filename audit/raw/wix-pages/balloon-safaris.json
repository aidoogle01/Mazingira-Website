e":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvnrjpap":{"type":"BackgroundMedia","id":"dataItem-lvnrjpap","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"oqg-7204"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvnru0yc":{"type":"StyledText","id":"dataItem-lvnru0yc","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"orz-311"},"text":"<h1 class=\"font_2\" style=\"font-size: 54px; text-align: center;\"><span style=\"font-size:54px;\"><span style=\"font-family:raleway,sans-serif;\"><span class=\"color_36\">Hot Air Balloon Safari</span></span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnrw45g":{"type":"StyledText","id":"dataItem-lvnrw45g","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"oqg-7485"},"text":"<p class=\"font_8\">Experience the thrill of a hot-air balloon safari in Tanzania&#39;s Serengeti, one of the most iconic wildlife destinations on the planet. As the balloon inflates in the cool early morning air, anticipation builds. Soon, you&#39;re silently ascending over the expansive savannahs, rich with wildlife and stunning scenery. Designed for small groups, this unique adventure offers an unparalleled view of the Serengeti&#39;s vast landscapes and the annual Great Migration.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\">From your vantage point above, you gain a profound appreciation of the sheer scale of the landscape and the incredible journey undertaken by countless wildebeest, zebra, and gazelle. The quiet glide of the balloon allows you to observe the natural behaviors of these animals without disturbance, providing extraordinary photo opportunities and a peaceful observation of their daily life and survival challenges.</p>\n\n<p class=\"font_8\">A hot-air balloon safari in the Serengeti is not just a ride; it&#39;s an extraordinary way to witness the world&#39;s most spectacular wildlife migration and adds an unforgettable perspective to your Tanzanian adventure. This experience, often highlighted as a must-do, enriches any wildlife-viewing itinerary with its breathtaking panoramas and serene, floating journey through the sky.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvnrxsrl":{"type":"StyledText","id":"dataItem-lvnrxsrl","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"r8v-119"},"text":"<p class=\"font_4\" style=\"font-size: 38px; text-align: center;\"><span style=\"font-size:38px\">Our Wonderful Partners Serengeti Balloon Safari&#39;s</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvns29ke":{"type":"VideoPlayer","id":"dataItem-lvns29ke","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"o75-717"},"videoTitle":"","description":"Serengeti Balloon Safari Experience , with Serengeti Balloon Safaris, this shows from start to finish the experinece of a hot air balloon safari over the serengeti start at sunrise ","videoType":"youtube","videoUrl":"https://youtu.be/RNIMtseS2uk?feature=shared"},"dataItem-lvns6nbk":{"type":"StylableButton","id":"dataItem-lvns6nbk","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"oqg-7728"},"label":"CONTACT US ","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-lvns7jic"},"dataItem-lvns7jic":{"type":"AnchorLink","id":"dataItem-lvns7jic","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"oqg-7729"},"anchorName":"Contact","pageId":"#dzuwe","anchorDataId":"#anchors-lvb8gx7c2"},"vic7x":{"type":"Page","id":"vic7x","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"f4w-1"},"title":"Balloon Safari's","hideTitle":true,"icon":"","descriptionSEO":"Elevate your Serengeti adventure with a hot air balloon safari. Wit