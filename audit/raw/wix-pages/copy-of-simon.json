:"2.0","isHidden":false,"sig":"w3q-378"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2puges":{"type":"BackgroundMedia","id":"dataItem-lw2puges","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"w3q-381"},"mediaRef":"#dataItem-lw2puges1","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2puges1":{"type":"Image","id":"dataItem-lw2puges1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"w3q-380"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2pugfo":{"type":"SvgShape","id":"dataItem-lw2pugfo","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"w3q-400"}},"dataItem-lw2pugfq2":{"type":"StyledText","id":"dataItem-lw2pugfq2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"w3q-457"},"text":"<p class=\"font_8\">I am Lucas, born and raised in the Arusha region of Tanzania. My family&#39;s roots lie in the Kilimanjaro region with the Chagga tribe, and over a century ago, they settled along the slopes of Mount Meru. Growing up in this lush environment, my guiding dream was sparked by my grandfather, who was a coffee farmer. For over a decade, I lived with him on his large estate, where we cultivated coffee, bananas, vegetables, and flowers. The greenery attracted numerous bird species and small animals, which my grandfather protected and appreciated.</p>\n\n<p class=\"font_8\">Inspired by his love for nature, I developed a passion for flora, fauna, and wildlife, learning about them in our local language. After high school, I pursued my interest in the tourism industry, studying at the Arusha College of Tourism and then specializing at PROTS in professional tour guiding.</p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">I have worked with several safari companies, guiding in Tanzania&#39;s parks, conservation areas, cultural sites, and town tours. I take pride in using my expertise to offer authentic safari experiences in Tanzania, where I can share my knowledge and perspective with people from around the world. One of my most unique experiences has been witnessing the incredible migration of over 2 million wildebeests and zebras, as they journey from southern Serengeti across the Mara River to the Maasai Mara ecosystem.</p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">You&#39;re warmly welcome to explore Tanzania with Mazingira Safaris and create unforgettable safari memories! Thanks!</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mn4":{"type":"Page","id":"x6mn4","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"w3q-438"},"title":"Lucas","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-simon","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2pugeq","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2puges","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2pugfi":{"type":"MediaContainerDesignData","id":"dataItem-lw2pugfi","metaData":{"isPreset":false,