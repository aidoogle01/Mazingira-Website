hemaVersion":"2.0","isHidden":false,"sig":"8wu-2854"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2oudiv":{"type":"BackgroundMedia","id":"dataItem-lw2oudiv","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2857"},"mediaRef":"#dataItem-lw2oudiv1","color":"#EDEDED","colorOpacity":0.0,"alignType":"center","fittingType":"fill","scrollType":"scroll","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo"},"dataItem-lw2oudiv1":{"type":"Image","id":"dataItem-lw2oudiv1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-2856"},"title":"BG.jpg","uri":"a3c153_9626c8c325f844a9ab99f64662fe1395~mv2.jpg","description":"private/media-root","width":1920,"height":1080,"alt":"","artist":{"id":"","name":""},"opacity":0.0},"dataItem-lw2oudj8":{"type":"SvgShape","id":"dataItem-lw2oudj8","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2876"}},"dataItem-lw2oudja1":{"type":"StyledText","id":"dataItem-lw2oudja1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2933"},"text":"<p class=\"font_8\">My name is Tumsifu, but I&#39;m known as Thom. I grew up herding my family&#39;s livestock near Arusha National Park and Mount Meru, where I developed a fascination for wildlife. After completing secondary school in 2006, driven by my love for nature, I enrolled in a private college in Arusha in 2007, specializing in tour guiding and wildlife management.</p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">I began my career in 2008 as a campsite attendant before advancing to roles as a waiter, truck driver, game package guide, and ultimately a safari guide. With over 13 years in the tourism industry, I joined the Mazingira team in 2020 because their values aligned perfectly with my passion for nature and tourism. Working with them has shown me how richly blessed our beautiful country is.</p>\n\n<p class=\"font_8\" style=\"font-size: 6px;\"><span style=\"font-size:6px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">One of my favorite moments is watching the sun set over the umbrella acacia trees in the western Serengeti. I also cherish the varied sounds of animals at night during the wildebeest migration. My motto is to embrace the untamed beauty of Tanzania.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"x6mmz":{"type":"Page","id":"x6mmz","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"8wu-2913"},"title":"Thom","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-goodluck-nathan","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":true,"indexable":false,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lw2oudiu","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lw2oudiv","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"ignoreBottomBottomAnchors":true}},"design_data":{"dataItem-lw2oudj41":{"type":"MediaContainerDesignData","id":"dataItem-lw2oudj41","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2893"},"background":"#dataItem-lw2oudjd","charas":"design-lw2kny39","dataChangeBehaviors":[]},"dataItem-lw2oudjd":{"type":"BackgroundMedia","id":"dataItem-lw2oudjd","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"8wu-2894"},"color":"#FFFFFF","colorOpacity":1.0,"alignType":"center","fittingType":"fill","scrollType":"none","colorOverlay":"","colorOverlayOpacity":0.0,"showOverlayForMediaType":"WixVideo