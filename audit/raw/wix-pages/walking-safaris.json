taData":{"sig":"9nr-554"},"dataQuery":"#e2pbi","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1340,"height":1759,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvozvij3","mobileHintsQuery":"mobileHints-lvozvguv","connectionQuery":"connection-lvozvguz","componentType":"mobile.core.components.Page","fixerVersionsQuery":"e2pbi"},"data":{"document_data":{"dataItem-lvozvguf":{"type":"BackgroundMedia","id":"dataItem-lvozvguf","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"a0o-264"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvozvgug":{"type":"BackgroundMedia","id":"dataItem-lvozvgug","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"a0o-265"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvp09eui":{"type":"StyledText","id":"dataItem-lvp09eui","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"orz-260"},"text":"<h1 class=\"font_2\" style=\"font-size: 73px; text-align: center;\"><span style=\"font-size:73px;\"><span style=\"font-family:raleway,sans-serif;\"><span style=\"color:#FFFFFF;\">Walking Safari&#39;s</span></span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp0ak90":{"type":"StyledText","id":"dataItem-lvp0ak90","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"lgk-3887"},"text":"<p class=\"font_8\" style=\"font-size:36px; text-align:center\"><span style=\"font-size:36px\">Walking Safari&rsquo;s &amp; Crater Rim Walks&nbsp;</span></p>\n\n<p class=\"font_8\" style=\"font-size: 6px; text-align: center;\"><span style=\"font-size:6px;\"><span class=\"inherit-font-size\"><span class=\"wixGuard\">​</span></span></span></p>\n\n<p class=\"font_8\">Enhance your Tanzanian adventure by including a walking safari in your itinerary. This unique experience allows you to immerse yourself in the vibrant ecosystems of Tanzania, exploring them on foot for a closer, more intimate encounter with nature. Led by experienced, armed rangers, your safety is ensured as you navigate through the diverse landscapes.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp0e2cn":{"type":"StyledText","id":"dataItem-lvp0e2cn","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-749"},"text":"<p class=\"font_8\"><span style=\"font-size:20px\">Expert Guidance for a Safe Journey</span><br />\nYour walking safari will be guided by professional rangers who are not only equipped to ensure your safety but are also deeply knowledgeable about the local wildlife and terrain. Their expertise allows you to delve into the intricacies of the African bush with confidence and curiosity.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px\">Discover Arusha National Park and Beyond</span><br />\nA walking safari in Arusha National Park is an excellent choice, especially as a concluding highlight of your journey. Its proximity to Kilimanjaro Airport makes it an accessible and rewarding destination. Each step through this park offers the chance to encounter a wide array of animals in their natural habitats&mdash; from graceful giraffes and buffaloes to a variety of bird species.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px\">Crater Rim Walk at Ngorongoro</span><br />\nFor a truly spectacular perspective, opt for a crater rim walk around the Ngorongoro Crater. This walk offers an amazing insight into the wildlife and vegetation that inhabit the crater&#39;s rim. The elevated views over the crater floor, combined with the lush, diverse ecosystem at the rim, provide a unique opportunity to observe and appreciate the natural beauty and ecological variety of this famous conservation area.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span style=\"font-size:20px\">Tailored Experiences Across Tanzania</span><br />\nWhile Arusha National Park and the Ngorongoro Crater are prime locations for walking safaris, other parks throughout Tanzania also offer their unique landscapes and wildlife. Each park provides a different experience, from the sweeping plains of the Serengeti to the rugged terrains of Tarangire, enhancing your safari with new sights, sounds, and encounters.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">By choosing to participate in a walking safari, you gain a deeper appreciation of the natural world, experiencing the wonders of Tanzania from a ground-level perspective that few tours can match. This immersive experience brings you face-to-face with the untamed beauty of Africa in a truly memorable and engaging way.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp0loct":{"type":"Image","id":"dataItem-lvp0loct","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"du8-0"},"title":"","uri":"1ac0ef_b4e09c361af44aef89f75d8fdc4f9e9f~mv2.jpg","description":"","width":1859,"height":2481,"alt":"A tourist on a walking safari with Mazingira Safaris capturing the beauty of the African giraffe","crop":{"x":0,"y":479,"width":1859,"height":1985,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"name":"Facetune_02-05-2024-09-58-26_edited.jpg"},"dataItem-lvp0lod4":{"type":"Image","id":"dataItem-lvp0lod4","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"du8-1"},"title":"","uri":"1ac0ef_1eb4e5bc57d14007890400665d7ae6ba~mv2.jpg","description":"","width":1859,"height":4032,"alt":"Tourists with a safari guide on a crater rim walk round the ngorongoro crater , learning about the flora and fauna","name":"Facetune_15-04-2024-09-23-15.jpg"},"dataItem-lvp0rd4e":{"type":"StyledText","id":"dataItem-lvp0rd4e","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"a0o-1385"},"text":"<h2 class=\"font_2\" style=\"font-size: 58px;\"><span style=\"font-size:58px;\"><span class=\"color_36\"><span style=\"font-family:raleway,sans-serif;\">Would you like to add a walking Safari to your trip ?</span></span></span></h2>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvp0t7d4":{"type":"StylableButton","id":"dataItem-lvp0t7d4","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"lgk-4191"},"label":"CONTACT US ","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-lw7nws2l"},"dataItem-lw7nws2l":{"type":"PageLink","id":"dataItem-lw7nws2l","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"lgk-4192"},"pageId":"#dzuwe","target":"_self","rel":[]},"e2pbi":{"type":"Page","id":"e2pbi","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"9nr-566"},"title":"Walking Safari's","hideTitle":true,"icon":"","descriptionSEO":"Discover the thrill of walking safaris with our expert guides. Explore the wilderness up-close, enjoy intimate encounters with wildlife, and gain unique insights at a slower pace. Experience nature like never before with our immersive walking safari adventures.","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"walking-safaris","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":false,"indexable":true,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lvozvguf","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lvozvgug","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"advancedSeoData":"{\"tags\":[{\"type\":\"meta\",\"props\":{\"name\":\"description\",\"content\":\"Discover the thrill of walking safaris with our expert gui