le":0.9444444444444444,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lwqgg7az","mobileHintsQuery":"mobileHints-lwqgg7b1","connectionQuery":"connection-lwqgg7b9","componentType":"wysiwyg.viewer.components.WRichText","sourceQuery":"source-lwqgg7k6"}],"designQuery":"#dataItem-lwqgeiuy1","layout":{"width":320,"height":462,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lwqgeiuy","connectionQuery":"connection-lwqgeiv1","anchorQuery":"anchors-lwqgeiuz","componentType":"wysiwyg.viewer.components.ClassicSection"}],"mobileMetaData":{"sig":"jc5-0"},"dataQuery":"#j2q20","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1039,"height":1522,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lwqgeip0","mobileHintsQuery":"mobileHints-lwqgegrx","connectionQuery":"connection-lwqgegs3","componentType":"mobile.core.components.Page","fixerVersionsQuery":"j2q20"},"data":{"document_data":{"dataItem-lwqgegri":{"type":"BackgroundMedia","id":"dataItem-lwqgegri","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"o75-718"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lwqgegrj":{"type":"BackgroundMedia","id":"dataItem-lwqgegrj","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"o75-719"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lwqgg7ay":{"type":"StyledText","id":"dataItem-lwqgg7ay","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"o75-1399"},"text":"<h3 class=\"font_3\" style=\"font-size:24px\"><span style=\"font-size:24px\">Accessibility Statement for Mazingira Safari</span></h3>\n\n<h3 class=\"font_3\" style=\"font-size:24px\"><span style=\"font-size:24px\"><span class=\"wixGuard\">​</span></span></h3>\n\n<h4 class=\"font_4\" style=\"font-size:21px\"><span style=\"text-decoration:underline\"><span style=\"font-size:21px\">Commitment to Accessibility</span></span></h4>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">At Mazingira Safari, we are committed to providing an accessible website experience for all our users, regardless of their physical abilities or limitations. We strive to ensure that our website complies with the highest standards of accessibility and usability, adhering to both UK and Tanzanian legal requirements.</span></p>\n\n<h4 class=\"font_4\" style=\"font-size:21px\"><span style=\"text-decoration:underline\"><span style=\"font-size:21px\">Legal Requirements</span></span></h4>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Our accessibility efforts are guided by the Web Content Accessibility Guidelines (WCAG) 2.1, Level AA, which are recognized globally as the benchmark for web accessibility. We aim to meet or exceed these guidelines to ensure that our website is accessible to as many people as possible. This includes compliance with the Equality Act 2010 in the UK and relevant accessibility regulations in Tanzania.</span></p>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\"><span class=\"wixGuard\">​</span></span></p>\n\n<h4 class=\"font_4\" style=\"font-size:21px\"><span style=\"text-decoration:underline\"><span style=\"font-size:21px\">Measures to Support Accessibility</span></span></h4>\n\n<h4 class=\"font_4\" style=\"font-size:11px\"><span style=\"font-size:11px\"><span style=\"text-decoration:underline\"><span class=\"wixGuard\">​</span></span></span></h4>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">To ensure our website is accessible, we have implemented the following measures:</span></p>\n\n<ul class=\"font_8\" style=\"font-size:18px\">\n\t<li>\n\t<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Alternative Text for Images: All images on our website include descriptive alt text to assist users who rely on screen readers.</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Keyboard Navigation: Our website is fully navigable using a keyboard to accommodate users with mobility impairments.</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Contrast and Readability: We use high-contrast text and background combinations to improve readability for users with visual impairments.</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Responsive Design: Our website is designed to be fully responsive, providing an optimal viewing experience on a variety of devices, including mobile phones and tablets.</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Regular Audits: We conduct regular accessibility audits to identify and address any potential issues. Feedback from users is highly valued and helps us continuously improve our website&#39;s accessibility.</span></p>\n\t</li>\n</ul>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\"><span class=\"wixGuard\">​</span></span></p>\n\n<h4 class=\"font_4\" style=\"font-size:21px\"><span style=\"text-decoration:underline\"><span style=\"font-size:21px\">Assistance and Feedback</span></span></h4>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">If you encounter any accessibility barriers on our website or have suggestions for improvement, please contact us. We are committed to making our website as accessible as possible and will do our best to address any issues promptly.</span></p>\n\n<ul class=\"font_8\" style=\"font-size:18px\">\n\t<li>\n\t<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Email: info@mazingirasafari.com</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Phone: +255 784278205 (Tanzania)&nbsp;</span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Mail: Mazingira Safari, P.O. Box 12345, Arusha, Tanzania</span></p>\n\t</li>\n</ul>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\"><span class=\"wixGuard\">​</span></span></p>\n\n<h4 class=\"font_4\" style=\"font-size:21px\"><span style=\"text-decoration:underline\"><span style=\"font-size:21px\">Continuous Improvement</span></span></h4>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">We are dedicated to continuous improvement and regularly update our accessibility practices to ensure we meet current guidelines and best practices. We work with accessibility experts and incorporate user feedback to enhance the user experience for everyone.</span></p>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\"><span class=\"wixGuard\">​</span></span></p>\n\n<h4 class=\"font_4\" style=\"font-size:21px\"><span style=\"text-decoration:underline\"><span style=\"font-size:21px\">Legal Compliance</span></span></h4>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">This accessibility statement was prepared to comply with the legal requirements in the UK and Tanzania. We regularly review our compliance to ensure we meet the necessary standards and regulations.</span></p>\n\n<p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Thank you for visiting Mazingira Safari. We are committed to making our website accessible to all users and appreciate your support in our efforts to provide an inclusive online experience</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lwqgmat1":{"type":"StyledText","id":"dataItem-lwqgmat1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"z6a-73"},"text":"<h1 class=\"font_2\" style=\"font-size: 34px;\"><span style=\"font-size:34px;\"><span style=\"color:#FFFFFF;\"><span style=\"font-style:normal\"><span style=\"font-family:raleway,sans-serif\"><span style=\"font-weight:400\">Accessibility Statement for Mazingira Safari</span></span></span></span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"j2q20":{"type":"Page","id":"j2q20","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"0jb-5"},"title":"Accessibility Statement","hideTitle":true,"icon":"","descriptionSEO":"Discover Mazingira Safari's commitment to web accessibility. Read our accessibility statement to learn how we ensure an inclusive online experience for all users, meeting both UK and Tanzanian legal requirements.","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"accessibility-statement","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false,"passwordDigest":"","dialogLanguage":""},"isPopup":false,"indexable":true,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-lwqgegri","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-lwqgegrj","isPreset":true,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"advancedSeoData":"{\"tags\":[{\"type\":\"meta\",\"props\":{\"name\":\"description\",\"content\":\"Discover Mazingira Safari's commitment to web accessibility. Read our accessibility statement to learn how we ensure an inclusive online experience for all users, meeting both UK and Tanzanian legal requirements.\"},\"children\":\"\",\"custom\":false,\"disabled\":false}]}"}},"design_data":{"dataItem-lwqgeiuy1":{"type":"MediaContainerDesignData","id":"dataItem-lwqgeiuy1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"o75-753"},"background":"#dataItem-lwqgeiuy2"},"dataItem-lwqgeiuy2":{"type":"BackgroundM