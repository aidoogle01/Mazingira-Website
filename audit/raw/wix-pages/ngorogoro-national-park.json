bileHintsQuery":"mobileHints-lvpshyib","connectionQuery":"connection-lvpshfsn","componentType":"wysiwyg.viewer.components.WRichText","sourceQuery":"source-lvpshgga"}],"skin":"wysiwyg.viewer.skins.area.DefaultAreaSkin","layout":{"width":275,"height":149,"x":22,"y":1878,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"mobileHintsQuery":"mobileHints-lvps8zlr3","connectionQuery":"connection-lvps8zls1","componentType":"mobile.core.components.Container"},{"type":"Container","styleId":"strc1","metaData":{"sig":"lgk-906"},"id":"comp-lvps8zlu2","components":[{"type":"Container","styleId":"mc1","metaData":{"sig":"wrw-5573"},"id":"comp-lvps8zlx","components":[],"designQuery":"#dataItem-lvps8zly","layout":{"width":320,"height":50,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvptonsx","mobileHintsQuery":"mobileHints-lvps8zm0","connectionQuery":"connection-lvps8zm01","componentType":"wysiwyg.viewer.components.Column"}],"designQuery":"#dataItem-lvps8zlv1","layout":{"width":320,"height":50,"x":0,"y":2046,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvptonsw","mobileHintsQuery":"mobileHints-lvps8zlw","connectionQuery":"connection-lvps8zlw1","componentType":"wysiwyg.viewer.components.StripColumnsContainer"}],"designQuery":"#dataItem-lvps8z8p1","layout":{"width":320,"height":2096,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvps8z8p","mobileHintsQuery":"mobileHints-lvps8zn2","connectionQuery":"connection-lvps8z8q1","anchorQuery":"anchors-lvps8z8q","componentType":"wysiwyg.viewer.components.ClassicSection"}],"mobileMetaData":{"sig":"9nr-471"},"dataQuery":"#p5ya4","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1340,"height":2142,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"p5ya4","mobileHintsQuery":"p5ya4","connectionQuery":"p5ya4","componentType":"mobile.core.components.Page","fixerVersionsQuery":"p5ya4"},"data":{"document_data":{"dataItem-lvps8z7n":{"type":"BackgroundMedia","id":"dataItem-lvps8z7n","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"wrw-3298"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvps8z7t":{"type":"BackgroundMedia","id":"dataItem-lvps8z7t","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"wrw-3299"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvps8z97":{"type":"StyledText","id":"dataItem-lvps8z97","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"orz-177"},"text":"<h1 class=\"font_2\"><span class=\"color_36\">Nogorongoro National Park</span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvps8z9e2":{"type":"StyledText","id":"dataItem-lvps8z9e2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-4756"},"text":"<p class=\"font_8\" style=\"font-size: 24px;\"><span style=\"font-size:24px;\">Discover the Majestic Ngorongoro Crater</span></p>\n\n<p class=\"font_8\" style=\"font-size: 12px;\"><span style=\"font-size:12px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">The Ngorongoro Crater, a highlight of the Ngorongoro Conservation Area, is a breathtaking natural wonder formed two to three million years ago from the collapse of a massive volcano. This geological marvel has since evolved into a unique ecosystem with a rich tapestry of vegetation, making it a prime spot for ecological and wildlife observations.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvps8zl6":{"type":"ImageList","id":"dataItem-lvps8zl6","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-5106"},"items":["#dataItem-lvpt5tg9","#dataItem-lvpt5tgg1","#dataItem-lvpt5tgf","#dataItem-lvptdwhn","#dataItem-lvpt5tgb","#dataItem-lvpt5tgf1","#dataItem-lvpt5tgg","#dataItem-lvpt5tgf2"]},"dataItem-lvps8zld1":{"type":"StyledText","id":"dataItem-lvps8zld1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-4803"},"text":"<p class=\"font_8\" style=\"font-size:16px\"><span style=\"font-size:16px\">Today, the crater boasts the highest density of wildlife in Africa. Its 20-kilometer-wide and 600-meter-deep basin shelters zebras, buffaloes, warthogs, baboons, elephants, flamingos, ostriches, and hippos. Predators such as lions, hyenas, jackals, cheetahs, and leopards are also prevalent, contributing to its reputation as a top safari destination. </span></p>\n\n<p class=\"font_8\" style=\"font-size:16px\">&nbsp;</p>\n\n<p class=\"font_8\" style=\"font-size:16px\"><span style=\"font-size:16px\">The Ngorongoro Crater is particularly famous for offering visitors the chance to see the Big Five&mdash;buffalo, elephant, leopard, lion, and rhino&mdash;all within its expansive and picturesque landscape. The vistas from the crater rim are as stunning as the diverse wildlife that inhabits the crater floor.</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvps8zlm":{"type":"Image","id":"dataItem-lvps8zlm","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"f3s-0"},"title":"","uri":"1ac0ef_1d703aa0458843bcb4010e4ac6fab61e~mv2.png","description":"","width":756,"height":1507,"alt":"Note Pad ","crop":{"x":181,"y":0,"width":573,"height":1507,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"name":"Brown Vintage Blank Paper Torn Your Story-2.png"},"dataItem-lvps8zlp1":{"type":"StyledText","id":"dataItem-lvps8zlp1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-4617"},"text":"<p class=\"font_8\" style=\"font-size:22px\"><span style=\"font-size:22px\">IMPORTANT FACTS</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">The Ngorongoro Crater, recognized as one of Africa&#39;s natural wonders, is a premier wildlife sanctuary famed for its dense animal populations and stunning geological features. This unique natural amphitheater is a must-visit.</p>\n\n<p class=\"font_8\" style=\"font-size: 12px;\"><span style=\"font-size:12px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\" style=\"font-size:20px\"><span style=\"font-size:20px\">Most Prominent Wildlife:</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Lions: Known for their majesty and strength, &nbsp;are a common and thrilling sight within the crater.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Cheetahs: These swift predators are frequently observed across the crater floor.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Leopards: Elusive and powerful, leopards add an air of mystery to the crater&#39;s diverse ecosystem.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Wildebeest: With substantial numbers, these animals are central to the crater&#39;s ecological dynamics.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Zebras: Over 200,000 zebras add striking visuals to the landscape.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Gazelles: Numerous gazelles populate the area, playing a crucial role in the food chain.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Rhinos: As a key member of the Big Five, the endangered rhino is a treasured sighting in the crater.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Elephants: These gentle giants roam freely, adding to the grandeur of the environment.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Crocodiles and Hippos: Both are often seen in the crater&rsquo;s waters, with hippos prominently visible at Ngoitokitok Spring.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\" style=\"font-size: 10px;\"><span style=\"font-size:10px;\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\" style=\"font-size: 20px;\"><span style=\"font-size:20px;\">Noteworthy Facts:</span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Volcanic Basin: The crater was formed when a giant volcano exploded and collapsed, creating a natural enclosure for an incredibly diverse ecosystem.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">High Density of Wildlife: The crater is home to the highest density of predators and prey in Africa, offering unparalleled wildlife viewing opportunities.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Lush Forests and Lakes: The environment ranges from highland forest to grassland, punctuated with freshwater and alkaline lakes.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Endemic Species: The crater supports a variety of endemic species due to its isolated nature.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Viewpoints and Vistas: The rim of the crater provides spectacular views of the wildlife and landscapes below, especially breathtaking at sunrise and sunset.</p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvpshfsg":{"type":"StyledText","id":"dataItem-lvpshfsg","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-4303"},"text":"<h2 class=\"font_2\" style=\"font-size: 28px;\"><span style=\"font-size:28px;\">TRAVEL TIME TO NGORONGORO CONSERVATION AREA</span></h2>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Arusha to Ngorongoro Conservation Area: 3 hours</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Ngorongoro Conservation Area to Serengeti National Park: &nbsp;2 hours&rsquo; drive.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Ngorongoro Conservation Area to Lake Manyara: 1 hour drive.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Ngorongoro to Tarangire: 2 hours&rsquo; drive</p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvpsuroq":{"type":"Image","id":"dataItem-lvpsuroq","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"orz-183"},"title":"","uri":"1ac0ef_60d78ba507a8403bb51c1d35316af1b8~mv2.jpg","description":"","width":2226,"height":1603,"alt":"Masai people walking through the fields in the Ngorongoro region walking towards there home camps","name":"IMG_6667_edited.jpg","link":"#dataItem-lvpsxe7x"},"dataItem-lvpsve1l":{"type":"StyledText","id":"dataItem-lvpsve1l","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-4962"},"text":"<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Experience the Maasai Culture</span></p>\n\n<p class=\"font_8\" style=\"font-size:9px\"><span style=\"font-size:9px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">A visit to the Ngorongoro Conservation Area can also include a culturally enriching encounter with the Maasai tribe. The Maasai are permitted to graze their livestock within the conservation area, maintaining their traditional way of life amid the natural beauty of their surroundings.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\">For those interested in deepening their understanding of the Maasai&rsquo;s rich cultural heritage and rituals, booking a Maasai Tour is highly recommended. This immersive experience provides an intimate look at the vibrant culture of one of Africa&#39;s most iconic communities, complementing the natural wonders of the Ngorongoro Crater with a human touch.</p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvpsxe7x":{"type":"PageLink","id":"dataItem-lvpsxe7x","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"wrw-4965"},"pageId":"#z1olg","target":"_self","rel":[]},"dataItem-lvpt5tg9":{"type":"Image","id":"dataItem-lvpt5tg9","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"6wi-16"},"title":"The Beautiful view from The Crater Rim","uri":"1ac0ef_bb88bb6bfd2e4e7b94f49f04053fae77~mv2.jpg","width":4032,"height":1859,"alt":""},"dataItem-lvpt5tgb":{"t