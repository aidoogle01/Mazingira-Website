entType":"wysiwyg.viewer.components.Column"}],"designQuery":"#dataItem-lvr02sbq4","layout":{"width":320,"height":50,"x":0,"y":2022,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvr02sbq3","mobileHintsQuery":"mobileHints-lvr02sbq6","connectionQuery":"connection-lvr02sbq7","componentType":"wysiwyg.viewer.components.StripColumnsContainer"}],"designQuery":"#dataItem-lvr02saz1","layout":{"width":320,"height":2072,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-lvr02saz","mobileHintsQuery":"mobileHints-lvr02scb","connectionQuery":"connection-lvr02sb01","anchorQuery":"anchors-lvr02sb0","componentType":"wysiwyg.viewer.components.ClassicSection"}],"mobileMetaData":{"sig":"9nr-406"},"dataQuery":"#zq3rj","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1340,"height":2047,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"zq3rj","mobileHintsQuery":"zq3rj","connectionQuery":"zq3rj","componentType":"mobile.core.components.Page","fixerVersionsQuery":"zq3rj"},"data":{"document_data":{"dataItem-lvr02sad":{"type":"BackgroundMedia","id":"dataItem-lvr02sad","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"4bs-81"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvr02sad1":{"type":"BackgroundMedia","id":"dataItem-lvr02sad1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"4bs-82"},"color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"dataItem-lvr02sb81":{"type":"StyledText","id":"dataItem-lvr02sb81","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"lso-247"},"text":"<h1 class=\"font_2\"><span class=\"color_36\">Ruaha National Park</span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr02sbc3":{"type":"StyledText","id":"dataItem-lvr02sbc3","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"4bs-406"},"text":"<p class=\"font_7\" style=\"font-size:25px\"><span style=\"font-size:25px\">Explore the unique Ruaha Park&nbsp;</span></p>\n\n<p class=\"font_7\" style=\"font-size:16px\"><br />\n<span style=\"font-size:16px\">Ruaha National Park is celebrated as a premier wildlife sanctuary in Africa. Known for its rich biodiversity and large populations of elephants, Ruaha offers an unparalleled opportunity for close encounters with nature. Unlike the vast Serengeti, Ruaha boasts rugged landscapes and a more remote, less-traveled experience, making it a favorite for those seeking solitude and pristine wilderness. Spanning over 20,000 square kilometers (approximately 7,700 square miles), it is Tanzania&#39;s largest national park, providing a sanctuary for a diverse array of wildlife. Visitors can explore the park through our various safari packages and experience the untouched beauty of Ruaha for themselves.</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr02sbf":{"type":"ImageList","id":"dataItem-lvr02sbf","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"xjo-222"},"items":["#dataItem-lvr1w3qp","#dataItem-lvr1w3qp1","#dataItem-lvr1w3qq","#dataItem-lvr1w3qq1","#dataItem-lvr1w3qq2","#dataItem-lvr1w3qq3","#dataItem-lvr1w3qq4","#dataItem-lvr1w3qq5","#dataItem-lvr1w3qq6","#dataItem-lvr1w3qq7"]},"dataItem-lvr02sbg3":{"type":"StyledText","id":"dataItem-lvr02sbg3","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"xjo-131"},"text":"<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Discover More in Ruaha National Park</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">In Ruaha National Park, you can discover a world where the wild thrives in its most undisturbed form. This expansive park, marked by rugged landscapes and the winding Great Ruaha River, serves as a refuge for some of Africa&rsquo;s most iconic wildlife. Roaming its vast terrain, you&rsquo;ll find one of the largest populations of elephants in East Africa, alongside a variety of predators including lions, leopards, and elusive cheetahs. The park&rsquo;s birdlife is particularly rich, with over 570 recorded species, making it a paradise for birdwatchers. As you traverse through diverse habitats ranging from savannah to riverine forests, you&#39;re also likely to encounter majestic baobab trees, each with its own centuries-old story.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Experience the wonders in Ruaha National Park</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">The experience of visiting Ruaha National Park is unlike any other, offering activities that cater to both adventure seekers and those looking to immerse themselves in nature&rsquo;s quiet. Guided walking safaris are a highlight, allowing you to experience the African bush from the ground, guided by expert rangers who can provide insights into the subtle ecosystems and animal behaviors. For a different perspective, embark on a game drive which can be customized for morning, afternoon, or full-day excursions, maximizing your chances of witnessing a variety of wildlife interactions. Additionally, Ruaha&rsquo;s relative remoteness ensures that visitors can enjoy these experiences without the crowds found in more frequented parks, providing a more intimate connection with the natural world.</p>\n\n<p class=\"font_8\">&nbsp;</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr02sbm":{"type":"Image","id":"dataItem-lvr02sbm","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"c7c-0"},"title":"","uri":"1ac0ef_1d703aa0458843bcb4010e4ac6fab61e~mv2.png","description":"","width":756,"height":1507,"alt":"note pad","crop":{"x":181,"y":0,"width":573,"height":1507,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"name":"Brown Vintage Blank Paper Torn Your Story-2.png"},"dataItem-lvr02sbn2":{"type":"StyledText","id":"dataItem-lvr02sbn2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"4bs-612"},"text":"<p class=\"font_8\" style=\"font-size:24px\"><span style=\"font-size:24px\">IMPORTANT FACTS</span></p>\n\n<p class=\"font_8\" style=\"font-size:8px\"><span style=\"font-size:8px\"><span class=\"wixGuard\">​</span></span></p>\n\n<p class=\"font_8\">Ruaha National Park is renowned as one of the best places in Africa to experience the wilderness in its raw form, highlighted by its significant elephant population and diverse ecosystems.</p>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Most Prominent Wildlife:</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Elephants: Home to one of the largest populations of elephants in East Africa.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Lions: Famed for their large prides and dominance in the park.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Leopards: Skilled predators that are both elusive and mesmerizing.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Cheetahs: Known for their incredible speed and hunting prowess.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Kudus: Notable for their majestic horns and elegance.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Giraffes: Towering figures that gracefully navigate the park&rsquo;s landscapes.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Wild Dogs: Rare and thrilling sightings of these highly social and effective hunters.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Crocodiles and Hippos: Commonly found along the Great Ruaha River, providing spectacular sightings.</p>\n\t</li>\n</ul>\n\n<p class=\"font_8\"><span class=\"wixGuard\">​</span></p>\n\n<p class=\"font_8\" style=\"font-size:21px\"><span style=\"font-size:21px\">Noteworthy Facts:</span></p>\n\n<p class=\"font_8\" style=\"font-size:6px\"><span style=\"font-size:6px\"><span class=\"wixGuard\">​</span></span></p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Rugged Terrain: The park is characterised by its raw, semi-arid bush country, interspersed with baobab trees and the Great Ruaha River.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Birdwatching Paradise: With over 570 bird species, it&#39;s a haven for bird enthusiasts.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Baobab and Acacia Trees: These iconic trees dot the landscape, providing food and shelter to a multitude of species.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Seasonal Rivers and Waterholes: These are focal points for wildlife, especially during the dry season when animals gather in large numbers.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Remote Wilderness: Offers a more secluded safari experience compared to more frequented parks, allowing for intimate wildlife encounters.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Mwagusi Sand River: An ephemeral river providing dramatic wildlife viewing opportunities as animals congregate around this crucial water.</p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr02sbp3":{"type":"StyledText","id":"dataItem-lvr02sbp3","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"4bs-613"},"text":"<p class=\"font_8\">TRAVEL TIME TO RUAHA NATIONAL PARK</p>\n\n<ul class=\"font_8\">\n\t<li>\n\t<p class=\"font_8\">Dar es Salaam to Ruaha: Approximately 10 hours&#39; drive.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Dodoma to Ruaha: About 6 hours&#39; drive.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Iringa to Ruaha: Roughly 2 hours&#39; drive.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Mbeya to Ruaha: Around 8 hours&rsquo; drive.</p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\">Flight from Dar es Salaam to Ruaha: 1.5 hours (cost varies, typically around &euro;300 per person, one way).</p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-lvr1w3qp":{"type":"Image","id":"dataItem-lvr1w3qp","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"py2-0"},"title":"Young Lions","uri":"1ac0ef_bdd88d1c74c241e7a4b3faae88e61994~mv2.png","width":832,"height":614,"alt":""},"dataItem-lvr1w3qp1":{"type":"Image","id":"dataItem-lvr1w3qp1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"py2-1"},"title":"Elephant","uri":"1ac0ef_ed6c561f6e6442d69bf7e4d746da8f31~mv2.png","width":668,"height":868,"alt":""},"dataItem-lvr1w3qq":{"type":"Image","id":"dataItem-lvr1w3qq","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"py2-2"},"title":"Tortoise","uri":"1ac0ef_40aebe17ce504a72ad065cb8e41e7569~mv2.png","width":1202,"height":744,"alt":""},"dataItem-lvr1w3qq1":{"type":"Image","id":"dataItem-lvr1w3qq1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"py2-3"},"title":"Male Lion","uri":"1ac0ef_7c9f8d95b6db4f5084b917e3ffc9f89b~mv2.png","width":1318,"height":966,"alt":""},"dataItem-lvr1w3qq2":{"type":"Image","id":"dataItem-lvr1w3qq2","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"py2-4"},"title":"Beautiful Ruaha","uri":"1ac0ef_ebc2ad95edaa490099ed13d718ace8fe~mv2.png","width":1336,"height":960,"alt":""},"dataItem-lvr1w3qq3":{"type":"Image","id":"dataItem-lvr1w3qq3","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"py2-5"},"title":"African Wilddogs","uri":"