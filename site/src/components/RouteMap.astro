---
// The signature route map, drawn at build time from real coordinates (no JavaScript needed to see it).
// A few lines of script draw the route once when it scrolls into view; nothing else on the site moves.
interface Props { stops: string[]; title: string }
const { stops, title } = Astro.props;

const PLACES: Record<string, { name: string; lat: number; lon: number; off?: boolean }> = {
  arusha: { name: 'Arusha', lat: -3.37, lon: 36.68 },
  kilimanjaro: { name: 'Kilimanjaro Airport', lat: -3.43, lon: 37.07 },
  tarangire: { name: 'Tarangire', lat: -3.95, lon: 36.05 },
  'lake-manyara': { name: 'Lake Manyara', lat: -3.53, lon: 35.82 },
  karatu: { name: 'Karatu', lat: -3.34, lon: 35.67 },
  ngorongoro: { name: 'Ngorongoro Crater', lat: -3.2, lon: 35.53 },
  ndutu: { name: 'Ndutu', lat: -3.0, lon: 34.98 },
  serengeti: { name: 'Central Serengeti', lat: -2.43, lon: 34.82 },
  'north-serengeti': { name: 'Northern Serengeti', lat: -1.62, lon: 34.9 },
  'lake-natron': { name: 'Lake Natron', lat: -2.42, lon: 36.0 },
  zanzibar: { name: 'Zanzibar', lat: -6.16, lon: 39.2, off: true },
};
const F = { west: 34.4, east: 37.4, north: -1.3, south: -4.3 };
const W = 720, H = 560, P = 36;
const pt = (k: string) => {
  const p = PLACES[k];
  if (p.off) return { x: W - 8, y: H - 8, p };
  return { x: P + ((p.lon - F.west) / (F.east - F.west)) * (W - 2 * P), y: P + ((F.north - p.lat) / (F.north - F.south)) * (H - 2 * P), p };
};
const legs = stops.map((s) => ({ key: s.replace(/^fly:/, ''), fly: s.startsWith('fly:') }));
const visited = new Set(legs.map((l) => l.key));
const segs: { d: string; fly: boolean; len: number }[] = [];
legs.slice(1).forEach((l, i) => {
  const a = pt(legs[i].key), b = pt(l.key);
  if (a.x === b.x && a.y === b.y) return;
  if (!l.fly) { segs.push({ d: `M${a.x} ${a.y}L${b.x} ${b.y}`, fly: false, len: Math.hypot(b.x - a.x, b.y - a.y) }); return; }
  // flights arc away from the road route so they don't cross it
  const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2, dx = b.x - a.x, dy = b.y - a.y;
  let cx = mx + dy * 0.35, cy = my - dx * 0.35;
  if (cy > my) { cx = mx - dy * 0.35; cy = my + dx * 0.35; }
  segs.push({ d: `M${a.x} ${a.y}Q${cx} ${cy} ${b.x} ${b.y}`, fly: true, len: 0 });
});
const seen = new Set<string>();
const labels = legs.filter((l) => (seen.has(l.key) ? false : (seen.add(l.key), true))).map((l, i) => ({ ...pt(l.key), start: i === 0 }));
const others = Object.keys(PLACES).filter((k) => !visited.has(k) && !PLACES[k].off).map(pt);
---
<svg class="mz-route is-pending" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} data-route>
  <title>{title}</title>
  <text class="compass" x={W - P} y={P - 8} text-anchor="end">North</text>
  {others.map((o) => <circle class="landmark" cx={o.x} cy={o.y} r="3.5" />)}
  {segs.map((s) => <path class:list={['leg', { 'leg--fly': s.fly }]} d={s.d} style={`--len:${s.len.toFixed(1)}`} />)}
  {labels.map((l) => l.p.off ? (
    <text class="place" x={W - 14} y={H - 24} text-anchor="end">{l.p.name} (flight)</text>
  ) : (
    <g>
      <circle class:list={['stop', { 'stop--start': l.start }]} cx={l.x} cy={l.y} r={l.start ? 7 : 6} />
      <text class="place" x={l.x > W * 0.68 ? l.x - 12 : l.x + 12} y={l.y + 5} text-anchor={l.x > W * 0.68 ? 'end' : 'start'}>{l.p.name}</text>
    </g>
  ))}
</svg>
<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<SVGSVGElement>('[data-route]').forEach((svg) => {
    if (reduce || !('IntersectionObserver' in window)) { svg.classList.remove('is-pending'); return; }
    const legs = svg.querySelectorAll<SVGPathElement>('.leg');
    legs.forEach((p, i) => { if (!p.classList.contains('leg--fly')) p.style.setProperty('--len', String(p.getTotalLength())); p.style.animationDelay = `${i * 0.4}s`; });
    const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { svg.classList.add('is-drawing'); io.disconnect(); } }, { threshold: 0.3 });
    io.observe(svg);
  });
</script>
