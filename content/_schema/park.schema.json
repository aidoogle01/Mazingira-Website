{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "park.schema.json",
  "title": "Park",
  "description": "A destination. One file per park in content/parks/.",
  "type": "object",
  "required": [
    "id",
    "title",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "old_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "type": "string",
      "description": "Markdown"
    },
    "facts_intro": {
      "type": [
        "string",
        "null"
      ]
    },
    "wildlife": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "noteworthy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "travel_times": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "source": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "image": {
      "type": "object",
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "type": "string",
          "format": "uri"
        },
        "alt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
