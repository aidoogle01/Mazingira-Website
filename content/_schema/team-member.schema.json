{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team-member.schema.json",
  "title": "Team member",
  "type": "object",
  "required": [
    "id",
    "name",
    "role"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "bio": {
      "type": [
        "string",
        "null"
      ]
    },
    "photo": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
