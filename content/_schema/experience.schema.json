{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experience.schema.json",
  "title": "Experience",
  "description": "An add-on activity. content/experiences/.",
  "type": "object",
  "required": [
    "id",
    "title",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "type": "string",
      "description": "Markdown"
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "source": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "image": {
      "type": "object",
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "type": "string",
          "format": "uri"
        },
        "alt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
